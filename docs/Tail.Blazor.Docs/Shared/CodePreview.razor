@namespace Tail.Blazor.Docs.Shared
@inject IJSRuntime JS
@using Tail.Blazor.Button
@using static Tail.Blazor.Button.ButtonVariant
@using static Tail.Blazor.Button.ButtonSize

<div class="@GetContainerClasses()" style="border-color: var(--color-border); background-color: var(--color-surface);">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="flex items-center justify-between mb-3 pb-2 border-b" style="border-color: var(--color-border);">
            <h4 class="text-sm font-semibold" style="color: var(--color-text-primary);">@Title</h4>
            @if (ShowCopyButton)
            {
                <TailButton 
                    Size="ButtonSize.Sm"
                    Variant="@(copied ? ButtonVariant.Success : ButtonVariant.Outline)"
                    OnClick="CopyToClipboard"
                    Style="background-color: var(--color-surface-secondary); color: var(--color-text-primary);">
                    @if (copied)
                    {
                        <span class="inline-flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Copied!
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                            Copy
                        </span>
                    }
                </TailButton>
            }
        </div>
    }
    
    @if (ShowPreview)
    {
        <div class="@GetPreviewClasses()" style="@GetPreviewStyles()">
            @if (PreviewContent != null)
            {
                @PreviewContent
            }
            else
            {
                @ChildContent
            }
        </div>
    }
    
    @if (ShowCode)
    {
        <div class="relative">
            @if (!ShowPreview && ShowCopyButton)
            {
                <div class="absolute top-2 right-2">
                    <TailButton 
                        Size="ButtonSize.Sm"
                        Variant="@(copied ? ButtonVariant.Success : ButtonVariant.Outline)"
                        OnClick="CopyToClipboard"
                        Tooltip="Copy code"
                        Style="background-color: var(--color-surface-inverse); color: var(--color-text-on-inverse);">
                        @if (copied)
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                        }
                    </TailButton>
                </div>
            }
            <pre class="@GetCodeClasses()" style="@GetCodeStyles()"><code class="@GetCodeLanguageClass()">@GetEscapedCode()</code></pre>
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public string? CodeElementId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? PreviewContent { get; set; }
    [Parameter] public bool ShowPreview { get; set; } = false;
    [Parameter] public bool ShowCode { get; set; } = true;
    [Parameter] public bool ShowCopyButton { get; set; } = true;
    [Parameter] public string Language { get; set; } = "razor";
    [Parameter] public string? CssClass { get; set; }
    
    private bool copied = false;
    
    private string GetContainerClasses()
    {
        var classes = new List<string> { "rounded-lg border overflow-hidden mb-6" };
        if (!string.IsNullOrEmpty(CssClass))
        {
            classes.Add(CssClass);
        }
        return string.Join(" ", classes);
    }
    
    private string GetPreviewClasses()
    {
        return "p-6 border-b";
    }
    
    private string GetPreviewStyles()
    {
        return "background-color: var(--color-surface); border-color: var(--color-border); color: var(--color-text-primary);";
    }
    
    private string GetCodeClasses()
    {
        return "p-4 overflow-x-auto text-sm rounded-none m-0";
    }
    
    private string GetCodeStyles()
    {
        return "background-color: var(--color-surface-inverse); color: var(--color-text-on-inverse);";
    }
    
    private string GetCodeLanguageClass()
    {
        return $"language-{Language}";
    }
    

    
    private async Task CopyToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Code);
            copied = true;
            StateHasChanged();
            
            // Reset after 2 seconds
            await Task.Delay(2000);
            copied = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to copy: {ex.Message}");
        }
    }

    private string GetEscapedCode()
    {
        if (string.IsNullOrEmpty(Code))
            return string.Empty;
        
        // Return the code as-is since Razor automatically escapes @Code output
        // The HTML entities in the code will be properly displayed
        return Code;
    }
}
