@using Tail.Blazor.CollapsibleMenu
@using Tail.Blazor.Divider
@using Tail.Blazor.Layout
@using Tail.Blazor.Navigation
@using Tail.Blazor.Feedback
@using Tail.Blazor.Buttons
@using Tail.Blazor.Menu
@using Tail.Blazor.MenuItem
@using Tail.Blazor.Core.Theme
@using Tail.Blazor.Core.Enums
@using Tail.Blazor.Docs.Shared
@using System.Text.Json
@using System.IO
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@implements IDisposable


<TailMenu class="space-y-1">
    <!-- Home -->
    <TailMenuItem Href="/" IsActive="@IsActive("/")">
        <Icon>🏠</Icon>
        <ChildContent>Home</ChildContent>
    </TailMenuItem>

    <!-- Documentation -->
    <TailCollapsibleMenu Title="📚 Documentation" IsExpanded="@GetExpandedState("/docs")" IsExpandedChanged="@((bool expanded) => HandleExpandedChanged("/docs", expanded))">
        <TailMenu class="pl-4 space-y-1">
            <TailMenuItem Href="/docs" IsActive="@IsActive("/docs")">
                <ChildContent>Overview</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/docs/installation" IsActive="@IsActive("/docs/installation")">
                <ChildContent>Installation</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/getting-started" IsActive="@IsActive("/getting-started")">
                <ChildContent>Quick Start</ChildContent>
            </TailMenuItem>
        </TailMenu>
    </TailCollapsibleMenu>

    <!-- Components by Category (Auto-Generated from NavMenu.json) -->
    @if (navMenuData != null)
    {
        var componentsSection = navMenuData.Menu?.FirstOrDefault(m => m.Label == "Components");
        if (componentsSection?.Children != null)
        {
            @foreach (var category in componentsSection.Children)
            {
                var hasScrollableList = (category.Count ?? 0) > 10;
                <TailCollapsibleMenu Title="@($"{category.Icon} {category.Label}")" IsExpanded="@GetExpandedState(category.Path ?? "")" IsExpandedChanged="@((bool expanded) => HandleExpandedChanged(category.Path ?? "", expanded))">
                    <TailMenu class="pl-4 space-y-1">
                        <TailMenuItem Href="@category.Path" IsActive="@IsActive(category.Path ?? "")">
                            <ChildContent>All @category.Label</ChildContent>
                        </TailMenuItem>
                        <TailDivider class="my-1" />
                        <TailContainer Size="Tail.Blazor.Container.ContainerSize.Full" Class="@GetScrollableClass(hasScrollableList)">
                            <TailMenu class="space-y-1">
                                @if (category.Children != null)
                                {
                                    @foreach (var component in category.Children)
                                    {
                                        <TailMenuItem Href="@component.Path" IsActive="@IsActive(component.Path ?? "")" class="text-xs">
                                            <ChildContent>@component.Label</ChildContent>
                                        </TailMenuItem>
                                    }
                                }
                            </TailMenu>
                        </TailContainer>
                    </TailMenu>
                </TailCollapsibleMenu>
            }
        }
    }

    <!-- Theming -->
    <TailCollapsibleMenu Title="🎨 Theming" IsExpanded="@GetExpandedState("/theming")" IsExpandedChanged="@((bool expanded) => HandleExpandedChanged("/theming", expanded))">
        <TailMenu class="pl-4 space-y-1">
            <TailMenuItem Href="/theming" IsActive="@IsActive("/theming")">
                <ChildContent>Overview</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/theme-manager" IsActive="@IsActive("/theme-manager")">
                <ChildContent>Theme Manager</ChildContent>
            </TailMenuItem>
          
        </TailMenu>
    </TailCollapsibleMenu>

    <!-- Resources -->
    <TailCollapsibleMenu Title="📚 Resources" IsExpanded="@GetExpandedState("/examples")" IsExpandedChanged="@((bool expanded) => HandleExpandedChanged("/examples", expanded))">
        <TailMenu class="pl-4 space-y-1">
            <TailMenuItem Href="/examples" IsActive="@IsActive("/examples")">
                <Icon>💡</Icon>
                <ChildContent>Examples</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/best-practices" IsActive="@IsActive("/best-practices")">
                <Icon>✨</Icon>
                <ChildContent>Best Practices</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/faq" IsActive="@IsActive("/faq")">
                <Icon>❓</Icon>
                <ChildContent>FAQ</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/api" IsActive="@IsActive("/api")">
                <Icon>📚</Icon>
                <ChildContent>API Reference</ChildContent>
            </TailMenuItem>
            <TailMenuItem Href="/scope" IsActive="@IsActive("/scope")">
                <Icon>📊</Icon>
                <ChildContent>Scope & Status</ChildContent>
            </TailMenuItem>
        </TailMenu>
    </TailCollapsibleMenu>
</TailMenu>


@code {
    private string? _currentPath;
    private Dictionary<string, bool> _expandedStates = new();
    private NavMenuModel? navMenuData;

    private class NavMenuModel
    {
        public string? Version { get; set; }
        public string? LastUpdated { get; set; }
        public int TotalComponents { get; set; }
        public List<MenuSection>? Menu { get; set; }
    }

    private class MenuSection
    {
        public string? Label { get; set; }
        public string? Path { get; set; }
        public string? Icon { get; set; }
        public int? Count { get; set; }
        public List<MenuSection>? Children { get; set; }
        public string? Package { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _currentPath = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
        
        // Normalize initial path
        _currentPath = GetNormalizedPath(_currentPath);

        // Load navigation menu from generated JSON
        try
        {
            var filePath = Path.Combine(Environment.ContentRootPath, "Pages", "Components", "NavMenu.json");
            if (File.Exists(filePath))
            {
                var json = await File.ReadAllTextAsync(filePath);
                navMenuData = JsonSerializer.Deserialize<NavMenuModel>(json, new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                });
            }
            else
            {
                Console.WriteLine($"NavMenu.json not found at: {filePath}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load NavMenu.json: {ex.Message}");
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = GetNormalizedPath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private string GetNormalizedPath(string? path)
    {
        if (string.IsNullOrEmpty(path))
            return string.Empty;

        // Remove query string and hash
        var cleanPath = path.Split('?')[0].Split('#')[0];
        
        // Normalize to base relative path
        try
        {
            var baseRelative = Navigation.ToBaseRelativePath(cleanPath);
            return baseRelative.ToLowerInvariant().TrimEnd('/');
        }
        catch
        {
            // Fallback to direct path normalization
            return cleanPath.ToLowerInvariant().TrimEnd('/');
        }
    }

    private bool IsActive(string href)
    {
        if (string.IsNullOrEmpty(_currentPath) || string.IsNullOrEmpty(href))
            return false;

        // _currentPath is already normalized
        var currentPath = _currentPath;
        var targetPath = GetNormalizedPath(href);

        // Exact match
        if (currentPath == targetPath)
            return true;

        // For root path, only exact match
        if (targetPath == "/" || targetPath == "")
            return currentPath == "/" || currentPath == "";

        // Check if current path starts with target path (for sub-routes)
        // Ensure we match whole path segments, not partial matches
        if (currentPath.StartsWith(targetPath))
        {
            // Check if it's a complete segment match (ends with / or is at end of string)
            if (currentPath.Length == targetPath.Length || 
                currentPath[targetPath.Length] == '/')
            {
                return true;
            }
        }

        return false;
    }

    private bool IsExpanded(string href)
    {
        if (string.IsNullOrEmpty(_currentPath) || string.IsNullOrEmpty(href))
            return false;

        // _currentPath is already normalized
        var currentPath = _currentPath;
        var targetPath = GetNormalizedPath(href);

        // For root path, don't expand
        if (targetPath == "/" || targetPath == "")
            return false;

        // Check if current path starts with target path (for sub-routes)
        if (currentPath.StartsWith(targetPath))
        {
            // Ensure it's a complete segment match
            if (currentPath.Length == targetPath.Length || 
                currentPath[targetPath.Length] == '/')
            {
                return true;
            }
        }

        // Check if any child items in category groups are active
        if (navMenuData != null)
        {
            var componentsSection = navMenuData.Menu?.FirstOrDefault(m => m.Label == "Components");
            if (componentsSection?.Children != null)
            {
                var category = componentsSection.Children.FirstOrDefault(c => 
                    GetNormalizedPath(c.Path ?? "") == targetPath);
                
                if (category != null)
                {
                    // Check if the category overview is active
                    if (IsActive(category.Path ?? ""))
                        return true;

                    // Check if any child component is active
                    if (category.Children != null)
                    {
                        foreach (var component in category.Children)
                        {
                            if (IsActive(component.Path ?? ""))
                            {
                                return true;
                            }
                        }
                    }
                }
            }
        }

        // Check Documentation section children
        if (targetPath == "/docs" || targetPath == "docs")
        {
            if (IsActive("/docs") || IsActive("/docs/installation") || IsActive("/getting-started"))
                return true;
        }

        // Check Theming section children
        if (targetPath == "/theming" || targetPath == "theming")
        {
            if (IsActive("/theming") || IsActive("/theme-manager") || IsActive("/docs/theme-integration"))
                return true;
        }

        // Check Resources section children
        if (targetPath == "/examples" || targetPath == "examples")
        {
            if (IsActive("/examples") || IsActive("/best-practices") || 
                IsActive("/faq") || IsActive("/api") || IsActive("/scope"))
                return true;
        }

        return false;
    }

    private string GetScrollableClass(bool hasScrollableList)
    {
        return hasScrollableList ? "max-h-64 overflow-y-auto" : "";
    }

    private void HandleExpandedChanged(string href, bool expanded)
    {
        _expandedStates[href] = expanded;
        StateHasChanged();
    }

    private bool GetExpandedState(string href)
    {
        // If manually toggled, use that state
        if (_expandedStates.ContainsKey(href))
        {
            return _expandedStates[href];
        }
        // Otherwise, use the auto-expand logic based on active routes
        return IsExpanded(href);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
