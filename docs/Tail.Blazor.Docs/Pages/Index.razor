@page "/"
@using Tail.Blazor.Button
@using static Tail.Blazor.Button.ButtonVariant
@using static Tail.Blazor.Button.ButtonSize

<PageTitle>Tail.Blazor - Ultra-Lightweight Blazor Component Library</PageTitle>

<div class="min-h-screen" style="background-color: var(--color-surface); color: var(--color-text-primary);">
    <!-- Hero Section -->
    <div class="container mx-auto px-4 py-16">
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold mb-4" style="color: var(--color-text-primary);">
                Tail.Blazor
            </h1>
            <p class="text-xl mb-8" style="color: var(--color-text-secondary);">
                Ultra-lightweight, high-performance Blazor component library
            </p>
            <div class="flex justify-center gap-4">
                <TailButton Variant="ButtonVariant.Primary" Size="ButtonSize.Lg" OnClick="NavigateToGettingStarted">
                    Get Started
                </TailButton>
                <TailButton Variant="ButtonVariant.Outline" Size="ButtonSize.Lg" OnClick="NavigateToComponents">
                    View Components
                </TailButton>
            </div>
        </div>

        <!-- Features Grid -->
        <div class="grid md:grid-cols-3 gap-6 mt-16">
            <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                <h3 class="text-xl font-semibold mb-2">⚡ Ultra-Lightweight</h3>
                <p style="color: var(--color-text-secondary);">Core package only 48 KB - 5x smaller than competitors</p>
            </div>
            <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                <h3 class="text-xl font-semibold mb-2">🎨 Theme Engine</h3>
                <p style="color: var(--color-text-secondary);">Dynamic colors, gradients, and CSS variables</p>
            </div>
            <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                <h3 class="text-xl font-semibold mb-2">🚀 Zero-JS</h3>
                <p style="color: var(--color-text-secondary);">90% of components require no JavaScript</p>
            </div>
        </div>

        <!-- Component Stats -->
        <div class="mt-16 text-center">
            <h2 class="text-3xl font-bold mb-8" style="color: var(--color-text-primary);">Complete Component Library</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                    <div class="text-4xl font-bold mb-2" style="color: var(--color-primary);">70+</div>
                    <div style="color: var(--color-text-secondary);">Components</div>
                </div>
                <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                    <div class="text-4xl font-bold mb-2" style="color: var(--color-success, var(--color-primary));">12</div>
                    <div style="color: var(--color-text-secondary);">NuGet Packages</div>
                </div>
                <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                    <div class="text-4xl font-bold mb-2" style="color: var(--color-accent, var(--color-primary));">&lt;3ms</div>
                    <div style="color: var(--color-text-secondary);">Render Time</div>
                </div>
                <div class="p-6 rounded-lg shadow-md" style="background-color: var(--color-surface-1); color: var(--color-text-primary);">
                    <div class="text-4xl font-bold mb-2" style="color: var(--color-warning, var(--color-primary));">100%</div>
                    <div style="color: var(--color-text-secondary);">AOT Compatible</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] 
    private NavigationManager Navigation { get; set; } = default!;

    private void NavigateToGettingStarted()
    {
        Navigation.NavigateTo("/getting-started");
    }

    private void NavigateToComponents()
    {
        Navigation.NavigateTo("/components");
    }
}
