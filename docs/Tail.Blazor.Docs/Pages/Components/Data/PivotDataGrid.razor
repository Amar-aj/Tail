<TailPivotDataGrid />
";

    private string patternsCode = @"
Frequently used patterns and combinations:
";

    private string combinationsCode = @"
<TailPivotDataGrid RowHeader=""Sample RowHeader"" Columns=""Sample Columns"" Style=""Sample Style"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailPivotDataGrid  />
</div>

@code {
    // Component logic here
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "RowHeader", Type = "string", Default = """Row""", Description = "RowHeader parameter" },
        new() { Name = "Columns", Type = "List<string>", Default = "new()", Description = "Columns parameter" },
        new() { Name = "Rows", Type = "List<PivotRow>", Default = "new()", Description = "Rows parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
