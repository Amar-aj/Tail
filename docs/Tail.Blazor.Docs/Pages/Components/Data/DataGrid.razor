    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Data", Type = "List<T>", Default = "new()", Description = "Data parameter" },
        new() { Name = "Columns", Type = "List<DataGridColumn<T>>", Default = "new()", Description = "Columns parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
