@page "/components/data/virtualscroll"
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="VirtualScroll"
                 Description="VirtualScroll component for Tail.Blazor"
                 PackageName="Tail.Blazor.VirtualScroll"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Virtual scrolling for large lists</li>
            <li>Performance optimization</li>
            <li>Customizable item height</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <div class="p-4 rounded-lg mb-4" style="background-color: var(--color-surface-2); color: var(--color-text-primary);">
            <p class="font-medium">⚠️ Generic Component</p>
            <p class="text-sm mt-2">This component requires a type parameter. Example:</p>
            <code class="block mt-2 p-2 rounded" style="background-color: var(--color-surface-1);">
                &lt;TailVirtualScroll T="YourModel"&gt;...&lt;/TailVirtualScroll&gt;
            </code>
        </div>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Type Parameters</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>T</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Generic type parameter for typed data</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Items</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;T&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Data items collection</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ItemTemplate</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>RenderFragment&lt;T&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">default!</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ItemTemplate parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ItemHeight</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">50</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ItemHeight parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>VisibleCount</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">10</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Whether the component is visible</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Style</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Additional CSS styles</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

