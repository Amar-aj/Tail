    private bool isGeneric = true;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.VirtualScroll";

    private string basicCode = @"<TailVirtualScroll T=""YourModel"">Content</TailVirtualScroll>";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.VirtualScroll

<TailVirtualScroll>
    Hello, World!
</TailVirtualScroll>
";

    private string patternsCode = @"
Frequently used patterns and combinations:
";

    private string combinationsCode = @"
<TailVirtualScroll ItemHeight=""10"" VisibleCount=""10"" Style=""Sample Style"">
    Combined Parameters
</TailVirtualScroll>
