";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Items", Type = "List<T>", Default = "new()", Description = "Data items collection" },
        new() { Name = "ItemTemplate", Type = "RenderFragment<T>", Default = "default!", Description = "ItemTemplate parameter" },
        new() { Name = "ItemHeight", Type = "int", Default = "50", Description = "ItemHeight parameter" },
        new() { Name = "VisibleCount", Type = "int", Default = "10", Description = "Whether the component is visible" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
