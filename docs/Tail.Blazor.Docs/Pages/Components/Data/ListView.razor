@page "/components/data/listview"
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="ListView"
                 Description="ListView component for Tail.Blazor"
                 PackageName="Tail.Blazor.ListView"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <div class="p-4 rounded-lg mb-4" style="background-color: var(--color-surface-2); color: var(--color-text-primary);">
            <p class="font-medium">⚠️ Generic Component</p>
            <p class="text-sm mt-2">This component requires a type parameter. Example:</p>
            <code class="block mt-2 p-2 rounded" style="background-color: var(--color-surface-1);">
                &lt;TailListView T="YourModel"&gt;...&lt;/TailListView&gt;
            </code>
        </div>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Items</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;T&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Data items collection</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ItemTemplate</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>RenderFragment&lt;T&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">default!</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ItemTemplate parameter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = true;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ListView";

    private string basicCode = @"@* ListView requires type parameter *@";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Items", Type = "List<T>", Default = "new()", Description = "Data items collection" },
        new() { Name = "ItemTemplate", Type = "RenderFragment<T>", Default = "default!", Description = "ItemTemplate parameter" },
    };
}
