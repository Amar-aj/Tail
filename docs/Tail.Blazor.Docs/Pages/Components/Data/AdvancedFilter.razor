@page "/components/data/advancedfilter"
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="AdvancedFilter"
                 Description="AdvancedFilter component for Tail.Blazor"
                 PackageName="Tail.Blazor.AdvancedFilter"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Advanced filtering</li>
            <li>Field selection</li>
            <li>Operator selection</li>
            <li>Filter value input</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailAdvancedFilter />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Quick Start">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Get up and running in seconds.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailAdvancedFilter />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@quickstartCode" CodeElementId="quickstart-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Common Patterns">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Frequently used patterns and combinations.
        </p>
        <CodePreview Code="@patternsCode" CodeElementId="patterns-code" />
    </DocSection>

    <DocSection Title="Event Handling">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Handle user interactions with event callbacks.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailAdvancedFilter>
                        Click Me
                    </TailAdvancedFilter>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@eventsCode" CodeElementId="events-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Parameter Combinations">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Combine multiple parameters for advanced usage.
        </p>
        <CodePreview Code="@combinationsCode" CodeElementId="combinations-code" />
    </DocSection>

    <DocSection Title="Advanced Examples">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            More complex usage scenarios.
        </p>
        <CodePreview Code="@advancedCode" CodeElementId="advanced-code" />
    </DocSection>

    <DocSection Title="Real-World Example">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            A complete example showing practical usage.
        </p>
        <CodePreview Code="@realworldCode" CodeElementId="realworld-code" />
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Fields</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;string&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Fields parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Style</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Additional CSS styles</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnFilterApplied</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FilterCriteria</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised with FilterCriteria value</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Public Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Property</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FilterCriteria</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>class</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FilterCriteria property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Field</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Field property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Operator</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Operator property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Value</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Value property</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.AdvancedFilter";

    private string basicCode = @"<TailAdvancedFilter />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.AdvancedFilter

<TailAdvancedFilter />
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**With Click Handler**

```razor
<TailAdvancedFilter OnFilterApplied=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailAdvancedFilter>
```
";

    private string eventsCode = @"
<TailAdvancedFilter OnFilterApplied=""HandleOnFilterApplied"">
    Click Me
</TailAdvancedFilter>

@code {
    private void HandleOnFilterApplied(Tail.Blazor.AdvancedFilter.FilterCriteria args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailAdvancedFilter Fields=""Sample Fields"" Style=""Sample Style"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailAdvancedFilter OnFilterApplied=""HandleAction"" />
</div>

@code {
    private void HandleAction(FilterCriteria args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Fields", Type = "List<string>", Default = "new()", Description = "Fields parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
