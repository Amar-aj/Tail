@page "/components/validators/lengthvalidator"
@using Tail.Blazor.LengthValidator
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="LengthValidator"
                 Description="LengthValidator component for Tail.Blazor"
                 PackageName="Tail.Blazor.LengthValidator"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailLengthValidator />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.LengthValidator";

    private string basicCode = @"<TailLengthValidator />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
    };
}
