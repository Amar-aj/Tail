@page "/components/feedback/popover"
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Popover"
                 Description="Popover component for Tail.Blazor"
                 PackageName="Tail.Blazor.Popover"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <div class="p-4 rounded-lg mb-4" style="background-color: var(--color-surface-2); color: var(--color-text-primary);">
            <p class="font-medium">🚧 Coming Soon</p>
            <p class="text-sm mt-2">This component is planned but not yet implemented.</p>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = true;

    private string installCode = "dotnet add package Tail.Blazor.Popover";

    private string basicCode = @"<TailPopover />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Position", Type = "string", Default = """top""", Description = "Position parameter" },
        new() { Name = "Trigger", Type = "PopoverTrigger", Default = "PopoverTrigger.Click", Description = "Trigger parameter" },
    };
}
