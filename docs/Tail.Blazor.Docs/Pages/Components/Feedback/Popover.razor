@page "/components/popover"
@using Tail.Blazor.Docs.Shared

<PageTitle>Popover - Tail.Blazor</PageTitle>

<DocPageTemplate Title="TailPopover" 
                 Description="A popover component that displays content adjacent to a target element." 
                 PackageName="Tail.Blazor.Feedback"
                 ApiParameters="@apiParameters">
    <DocSection Title="Installation">
        <CodePreview Title="Install Package" Code="@installCode" />
    </DocSection>
    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Popover" Code="@basicCode">
            <PreviewContent>
                <!-- Component preview will be rendered here -->
            </PreviewContent>
        </CodePreview>
    </DocSection>
</DocPageTemplate>

@code {
    private string installCode = @"dotnet add package Tail.Blazor.Popover";
    private string basicCode = @"<TailPopover Title=""Title"">
    Content goes here
</TailPopover>";
    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new DocPageTemplate.ApiParameter { Name = "Title", Type = "string", Description = "Title of the popover", Default = "" },
        new DocPageTemplate.ApiParameter { Name = "Position", Type = "string", Description = "Position: top, bottom, left, right", Default = "top" }
    };
}
