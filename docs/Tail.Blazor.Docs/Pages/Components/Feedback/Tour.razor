                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Placement</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>TourTooltipPlacement</code></td>
