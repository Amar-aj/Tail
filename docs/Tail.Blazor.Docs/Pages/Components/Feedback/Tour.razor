@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Tour";

    private string basicCode = @"<TailTour />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.Tour

<TailTour />
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**With Click Handler**

```razor
<TailTour OnTourComplete=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailTour>
```
";

    private string eventsCode = @"
<TailTour OnTourComplete=""HandleOnTourComplete"">
    Click Me
</TailTour>

@code {
    private void HandleOnTourComplete()
    {
        // Handle the event
        Console.WriteLine(""Event triggered"");
    }
}
";

    private string combinationsCode = @"
<TailTour IsActive=""true"" Style=""Sample Style"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailTour OnTourComplete=""HandleAction"" />
</div>

@code {
    private void HandleAction()
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Steps", Type = "List<TourStep>", Default = "new()", Description = "Step value for numeric inputs" },
        new() { Name = "IsActive", Type = "bool", Default = "-", Description = "IsActive parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
