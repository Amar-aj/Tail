@page "/components/feedback/avatar"
@using Tail.Blazor.Docs.Shared

<DocPageTemplate Title="Avatar"
                 Description="Avatar component for Tail.Blazor"
                 PackageName="Tail.Blazor.Avatar"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Title="Package Installation" Code="@installCode" ShowPreview="false" Language="bash" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <div class="p-4 rounded-lg mb-4" style="background-color: var(--color-surface-2); color: var(--color-text-primary);">
            <p class="font-medium">🚧 Coming Soon</p>
            <p class="text-sm mt-2">This component is planned but not yet implemented.</p>
        </div>
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = true;

    private string installCode = @"dotnet add package Tail.Blazor.Avatar";

    private string basicCode = @"<TailAvatar />";

    private string sizesCode = @"
<TailAvatar Size=""string.Sm"">Small</TailAvatar>
<TailAvatar Size=""string.Md"">Medium</TailAvatar>
<TailAvatar Size=""string.Lg"">Large</TailAvatar>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "string", Default = """md""", Description = "Size of the component" },
    };
}
