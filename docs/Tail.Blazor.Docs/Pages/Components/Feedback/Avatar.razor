                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">"md"</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Public Properties</h3>
            <div class="overflow-x-auto">
