@page "/components/avatar"
@using Tail.Blazor.Docs.Shared

<PageTitle>Avatar - Tail.Blazor</PageTitle>

<DocPageTemplate Title="TailAvatar" 
                 Description="An avatar component for displaying user profile images or initials." 
                 PackageName="Tail.Blazor.Feedback"
                 ApiParameters="@apiParameters">
    <DocSection Title="Installation">
        <CodePreview Title="Install Package" Code="@installCode" />
    </DocSection>
    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Avatar" Code="@basicCode">
            <PreviewContent>
                <!-- Component preview will be rendered here -->
            </PreviewContent>
        </CodePreview>
    </DocSection>
</DocPageTemplate>

@code {
    private string installCode = @"dotnet add package Tail.Blazor.Avatar";
    private string basicCode = @"<TailAvatar ImageUrl=""https://example.com/avatar.jpg"" Initials=""JD"" />";
    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new DocPageTemplate.ApiParameter { Name = "ImageUrl", Type = "string", Description = "URL of the avatar image", Default = "" },
        new DocPageTemplate.ApiParameter { Name = "Initials", Type = "string", Description = "User initials as fallback", Default = "" },
        new DocPageTemplate.ApiParameter { Name = "Size", Type = "string", Description = "Avatar size: sm, md, lg", Default = "md" }
    };
}
