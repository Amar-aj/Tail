@page "/components/feedback/confetti"
@using Tail.Blazor.Confetti
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Confetti"
                 Description="Confetti component for Tail.Blazor"
                 PackageName="Tail.Blazor.Confetti"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailConfetti />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Confetti";

    private string basicCode = @"<TailConfetti />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ParticleCount", Type = "int", Default = "50", Description = "ParticleCount parameter" },
        new() { Name = "Shape", Type = "ConfettiShape", Default = "ConfettiShape.Mixed", Description = "Shape parameter" },
        new() { Name = "Duration", Type = "int", Default = "3000", Description = "Duration parameter" },
    };
}
