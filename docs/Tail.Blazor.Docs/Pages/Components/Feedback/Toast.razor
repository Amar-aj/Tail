@page "/components/feedback/toast"
@using Tail.Blazor.Toast
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Toast"
                 Description="Toast component for Tail.Blazor"
                 PackageName="Tail.Blazor.Toast"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs>
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailToast />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <TailTabs>
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailToast>Default</TailToast>
<TailToast>Variant 1</TailToast>
<TailToast>Variant 2</TailToast>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@variantsCode" CodeElementId="variants-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Toast";

    private string basicCode = @"<TailToast />";

    private string variantsCode = @"
<TailToast>Default</TailToast>
<TailToast>Variant 1</TailToast>
<TailToast>Variant 2</TailToast>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Variant", Type = "ToastVariant", Default = "ToastVariant.Info", Description = "Visual variant style for the component" },
        new() { Name = "Dismissible", Type = "bool", Default = "true", Description = "Dismissible parameter" },
        new() { Name = "ShowIcon", Type = "bool", Default = "true", Description = "Icon to display" },
        new() { Name = "AutoDismissAfter", Type = "int?", Default = "5000", Description = "AutoDismissAfter parameter" },
    };
}
