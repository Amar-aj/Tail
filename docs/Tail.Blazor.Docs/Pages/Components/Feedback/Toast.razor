@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Toast";

    private string basicCode = @"<TailToast>Content</TailToast>";

    private string variantsCode = @"
<TailToast Variant=""ToastVariant.Success"">Success</TailToast>
<TailToast Variant=""ToastVariant.Warning"">Warning</TailToast>
<TailToast Variant=""ToastVariant.Error"">Error</TailToast>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.Toast

<TailToast>
    Hello, World!
</TailToast>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Primary Action**

```razor
<TailToast Variant=""ToastVariant.Success"">
    Primary Action
</TailToast>
```

**With Click Handler**

```razor
<TailToast OnDismiss=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailToast>
```
";

    private string eventsCode = @"
<TailToast OnDismiss=""HandleOnDismiss"">
    Click Me
</TailToast>

@code {
    private void HandleOnDismiss()
    {
        // Handle the event
        Console.WriteLine(""Event triggered"");
    }
}
";

    private string combinationsCode = @"
<TailToast Variant=""ToastVariant.Success"" Message=""Sample Message"" Title=""Sample Title"" Dismissible=""true"" ShowIcon=""true"">
    Combined Parameters
</TailToast>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailToast Variant=""ToastVariant.Success"" OnDismiss=""HandleAction"">
        Action Button
    </TailToast>
</div>

@code {
    private void HandleAction()
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Message", Type = "string?", Default = "-", Description = "Message parameter" },
        new() { Name = "Title", Type = "string?", Default = "-", Description = "Title parameter" },
        new() { Name = "Variant", Type = "ToastVariant", Default = "ToastVariant.Info", Description = "Visual variant style for the component" },
        new() { Name = "Dismissible", Type = "bool", Default = "true", Description = "Dismissible parameter" },
        new() { Name = "ShowIcon", Type = "bool", Default = "true", Description = "Icon to display" },
        new() { Name = "Icon", Type = "RenderFragment?", Default = "-", Description = "Icon to display" },
        new() { Name = "AutoDismissAfter", Type = "int?", Default = "5000", Description = "AutoDismissAfter parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
