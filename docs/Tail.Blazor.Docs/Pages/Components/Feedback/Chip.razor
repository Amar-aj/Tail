                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Public Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Property</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Label</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Label property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Icon</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Icon property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Removable</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Removable property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnRemove</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>EventCallback</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">OnRemove property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Variant</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Variant property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>object</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Dictionary&lt;string,</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">object property</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = true;

    private string installCode = "dotnet add package Tail.Blazor.Chip";

    private string basicCode = @"<TailChip />";

    private string variantsCode = @"
<TailChip>Default</TailChip>
<TailChip>Secondary</TailChip>
<TailChip>Tertiary</TailChip>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Label", Type = "string", Default = "-", Description = "Label text for the component" },
        new() { Name = "Icon", Type = "string?", Default = "-", Description = "Icon to display" },
        new() { Name = "Removable", Type = "bool", Default = "-", Description = "Removable parameter" },
        new() { Name = "Variant", Type = "string", Default = """default""", Description = "Visual variant style for the component" },
        new() { Name = "AdditionalAttributes", Type = "Dictionary<string, object>?", Default = "-", Description = "AdditionalAttributes parameter" },
    };
}
