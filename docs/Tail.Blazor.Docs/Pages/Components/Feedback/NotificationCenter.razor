@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.NotificationCenter";

    private string basicCode = @"<TailNotificationCenter></TailNotificationCenter>";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Notifications", Type = "List<NotificationItem>", Default = "new()", Description = "Notifications parameter" },
        new() { Name = "Placement", Type = "NotificationCenterPlacement", Default = "NotificationCenterPlacement.TopRight", Description = "Placement parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
