@page "/components/feedback/badge"
@using Tail.Blazor.Badge
@using Tail.Blazor.Docs.Shared

<DocPageTemplate Title="Badge"
                 Description="Badge component for Tail.Blazor"
                 PackageName="Tail.Blazor.Badge"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Title="Package Installation" Code="@installCode" ShowPreview="false" Language="bash" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Example" Code="@basicCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <CodePreview Title="Variant Options" Code="@variantsCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <CodePreview Title="Size Options" Code="@sizesCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = @"dotnet add package Tail.Blazor.Badge";

    private string basicCode = @"<TailBadge />";

    private string variantsCode = @"
<TailBadge Variant=""BadgeVariant.Primary"">Primary</TailBadge>
<TailBadge Variant=""BadgeVariant.Secondary"">Secondary</TailBadge>
<TailBadge Variant=""BadgeVariant.Outline"">Outline</TailBadge>
";

    private string sizesCode = @"
<TailBadge Size=""BadgeSize.Sm"">Small</TailBadge>
<TailBadge Size=""BadgeSize.Md"">Medium</TailBadge>
<TailBadge Size=""BadgeSize.Lg"">Large</TailBadge>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Variant", Type = "BadgeVariant", Default = "BadgeVariant.Primary", Description = "Visual variant style for the component" },
        new() { Name = "Size", Type = "BadgeSize", Default = "BadgeSize.Md", Description = "Size of the component" },
    };
}
