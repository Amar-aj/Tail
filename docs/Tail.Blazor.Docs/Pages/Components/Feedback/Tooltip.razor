@page "/components/tooltip"
@using Tail.Blazor.Docs.Shared

<PageTitle>Tooltip - Tail.Blazor</PageTitle>

<DocPageTemplate Title="TailTooltip" 
                 Description="Contextual tooltip component with positioning (top, bottom, left, right) and delay options. Ultra-lightweight (~3 KB)."
                 PackageName="Tail.Blazor.Feedback"
                 ApiParameters="@apiParameters">

    <DocSection Title="Installation">
        <CodePreview Title="Install Package" Code="@installCode" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Tooltip" Code="@basicCode">
            <PreviewContent>
                <div class="flex gap-4 items-center justify-center p-8">
                    <div class="relative group">
                        <button class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">Hover me</button>
                        <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-2 py-1 bg-gray-800 text-white text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Hello from tooltip!</div>
                    </div>
                </div>
            </PreviewContent>
        </CodePreview>
    </DocSection>

    <DocSection Title="Positions">
        <CodePreview Title="Tooltip Positions" Code="@positionsCode">
            <PreviewContent>
                <div class="flex gap-8 items-center justify-center p-8 flex-wrap">
                    <div class="relative group">
                        <button class="px-3 py-2 bg-gray-300 rounded">Top</button>
                        <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-2 py-1 bg-gray-800 text-white text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity">Top position</div>
                    </div>
                    <div class="relative group">
                        <button class="px-3 py-2 bg-gray-300 rounded">Bottom</button>
                        <div class="absolute top-full left-1/2 transform -translate-x-1/2 mt-2 px-2 py-1 bg-gray-800 text-white text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity">Bottom position</div>
                    </div>
                    <div class="relative group">
                        <button class="px-3 py-2 bg-gray-300 rounded">Left</button>
                        <div class="absolute right-full top-1/2 transform -translate-y-1/2 mr-2 px-2 py-1 bg-gray-800 text-white text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity">Left position</div>
                    </div>
                    <div class="relative group">
                        <button class="px-3 py-2 bg-gray-300 rounded">Right</button>
                        <div class="absolute left-full top-1/2 transform -translate-y-1/2 ml-2 px-2 py-1 bg-gray-800 text-white text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity">Right position</div>
                    </div>
                </div>
            </PreviewContent>
        </CodePreview>
    </DocSection>

</DocPageTemplate>

@code {
    private string installCode = @"// Install package
dotnet add package Tail.Blazor.Tooltip

// Or using Package Manager
Install-Package Tail.Blazor.Tooltip";

    private string basicCode = @"<TailTooltip Content=""Hello from tooltip!"" Position=""top"">
    <button>Hover me</button>
</TailTooltip>";

    private string positionsCode = @"<TailTooltip Content=""Top"" Position=""top"">
    <button>Top</button>
</TailTooltip>

<TailTooltip Content=""Bottom"" Position=""bottom"">
    <button>Bottom</button>
</TailTooltip>

<TailTooltip Content=""Left"" Position=""left"">
    <button>Left</button>
</TailTooltip>

<TailTooltip Content=""Right"" Position=""right"">
    <button>Right</button>
</TailTooltip>";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new DocPageTemplate.ApiParameter { Name = "Content", Type = "string", Description = "Tooltip content text", Default = "" },
        new DocPageTemplate.ApiParameter { Name = "Position", Type = "string", Description = "Position: top, bottom, left, right", Default = "top" },
        new DocPageTemplate.ApiParameter { Name = "DelayMs", Type = "int", Description = "Delay in milliseconds before showing", Default = "0" },
        new DocPageTemplate.ApiParameter { Name = "ChildContent", Type = "RenderFragment", Description = "Content to show tooltip on", Default = "" }
    };
}
