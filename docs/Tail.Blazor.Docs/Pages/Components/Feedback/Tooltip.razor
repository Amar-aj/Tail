                            <td style="padding: 10px; border: 1px solid var(--color-border);">ChildContent property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Position</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Position property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>DelayMs</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">DelayMs property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Content</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Content property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>object</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Dictionary&lt;string,</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">object property</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = true;

    private string installCode = "dotnet add package Tail.Blazor.Tooltip";

    private string basicCode = @"<TailTooltip />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
        new() { Name = "Position", Type = "string", Default = """top""", Description = "Position parameter" },
        new() { Name = "DelayMs", Type = "int", Default = "0", Description = "DelayMs parameter" },
        new() { Name = "Content", Type = "string", Default = "-", Description = "Content parameter" },
        new() { Name = "AdditionalAttributes", Type = "Dictionary<string, object>?", Default = "-", Description = "AdditionalAttributes parameter" },
    };
}
