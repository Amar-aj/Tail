                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Dictionary&lt;string, object&gt;?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AdditionalAttributes parameter</td>
                        </tr>
