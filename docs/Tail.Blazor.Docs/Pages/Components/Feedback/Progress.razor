";

    private string combinationsCode = @"
<TailProgress Variant=""ProgressVariant.Primary"" Size=""ProgressSize.Md"" Value=""10"" ShowLabel=""true"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailProgress Variant=""ProgressVariant.Primary"" Size=""ProgressSize.Md"" />
</div>

@code {
    // Component logic here
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "int", Default = "-", Description = "Current value of the component" },
        new() { Name = "Variant", Type = "ProgressVariant", Default = "ProgressVariant.Primary", Description = "Visual variant style for the component" },
        new() { Name = "Size", Type = "ProgressSize", Default = "ProgressSize.Md", Description = "Size of the component" },
        new() { Name = "ShowLabel", Type = "bool", Default = "-", Description = "Label text for the component" },
        new() { Name = "LabelPosition", Type = "ProgressLabelPosition", Default = "ProgressLabelPosition.Outside", Description = "Label text for the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "Animated", Type = "bool", Default = "-", Description = "Animated parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
