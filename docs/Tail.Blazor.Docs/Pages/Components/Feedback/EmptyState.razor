@page "/components/feedback/emptystate"
@using Tail.Blazor.EmptyState
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="EmptyState"
                 Description="EmptyState component for Tail.Blazor"
                 PackageName="Tail.Blazor.EmptyState"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailEmptyState />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailEmptyState>Default</TailEmptyState>
<TailEmptyState>Variant 1</TailEmptyState>
<TailEmptyState>Variant 2</TailEmptyState>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@variantsCode" CodeElementId="variants-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailEmptyState>Small</TailEmptyState>
<TailEmptyState>Medium</TailEmptyState>
<TailEmptyState>Large</TailEmptyState>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.EmptyState";

    private string basicCode = @"<TailEmptyState />";

    private string variantsCode = @"
<TailEmptyState>Default</TailEmptyState>
<TailEmptyState>Variant 1</TailEmptyState>
<TailEmptyState>Variant 2</TailEmptyState>
";

    private string sizesCode = @"
<TailEmptyState>Small</TailEmptyState>
<TailEmptyState>Medium</TailEmptyState>
<TailEmptyState>Large</TailEmptyState>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "EmptyStateSize", Default = "EmptyStateSize.Md", Description = "Size of the component" },
        new() { Name = "Variant", Type = "EmptyStateVariant", Default = "EmptyStateVariant.Default", Description = "Visual variant style for the component" },
        new() { Name = "ShowDefaultIcon", Type = "bool", Default = "true", Description = "Icon to display" },
    };
}
