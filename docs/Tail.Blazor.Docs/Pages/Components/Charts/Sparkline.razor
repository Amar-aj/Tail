@page "/components/charts/sparkline"
@using Tail.Blazor.Sparkline
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Sparkline"
                 Description="Sparkline component for Tail.Blazor"
                 PackageName="Tail.Blazor.Sparkline"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailSparkline />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Data</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;double&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Data parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Width</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">100</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Width parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Height</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">30</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Height parameter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Sparkline";

    private string basicCode = @"<TailSparkline />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Data", Type = "List<double>", Default = "new()", Description = "Data parameter" },
        new() { Name = "Width", Type = "int", Default = "100", Description = "Width parameter" },
        new() { Name = "Height", Type = "int", Default = "30", Description = "Height parameter" },
    };
}
