@page "/components/layout/bottomsheet"
@using Tail.Blazor.BottomSheet
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="BottomSheet"
                 Description="BottomSheet component for Tail.Blazor"
                 PackageName="Tail.Blazor.BottomSheet"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Bottom sheet modal</li>
            <li>4 sizes (Sm, Md, Lg, Full)</li>
            <li>Backdrop click to close</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailBottomSheet></TailBottomSheet>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailBottomSheet Size="Tail.Blazor.BottomSheet.BottomSheetSize.Sm">Small</TailBottomSheet>
                    <TailBottomSheet Size="Tail.Blazor.BottomSheet.BottomSheetSize.Md">Medium</TailBottomSheet>
                    <TailBottomSheet Size="Tail.Blazor.BottomSheet.BottomSheetSize.Lg">Large</TailBottomSheet>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IsVisible</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Whether the component is visible</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ChildContent</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>RenderFragment?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ChildContent parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Size</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>BottomSheetSize</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">BottomSheetSize.Md</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>CloseOnBackdropClick</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Event callback raised when clicked</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Style</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Additional CSS styles</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IsVisibleChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.BottomSheet";

    private string basicCode = @"<TailBottomSheet></TailBottomSheet>";

    private string sizesCode = @"
<TailBottomSheet Size=""Tail.Blazor.BottomSheet.BottomSheetSize.Sm"">Small</TailBottomSheet>
<TailBottomSheet Size=""Tail.Blazor.BottomSheet.BottomSheetSize.Md"">Medium</TailBottomSheet>
<TailBottomSheet Size=""Tail.Blazor.BottomSheet.BottomSheetSize.Lg"">Large</TailBottomSheet>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "IsVisible", Type = "bool", Default = "-", Description = "Whether the component is visible" },
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
        new() { Name = "Size", Type = "BottomSheetSize", Default = "BottomSheetSize.Md", Description = "Size of the component" },
        new() { Name = "CloseOnBackdropClick", Type = "bool", Default = "true", Description = "Event callback raised when clicked" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
