@page "/components/layout/responsivelayout"
@using Tail.Blazor.ResponsiveLayout
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="ResponsiveLayout"
                 Description="ResponsiveLayout component for Tail.Blazor"
                 PackageName="Tail.Blazor.ResponsiveLayout"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailResponsiveLayout />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ResponsiveLayout";

    private string basicCode = @"<TailResponsiveLayout />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ShowMenuToggle", Type = "bool", Default = "true", Description = "ShowMenuToggle parameter" },
        new() { Name = "ShowThemeToggle", Type = "bool", Default = "true", Description = "ShowThemeToggle parameter" },
        new() { Name = "ShowAvatar", Type = "bool", Default = "false", Description = "ShowAvatar parameter" },
        new() { Name = "ShowSidebar", Type = "bool", Default = "true", Description = "ShowSidebar parameter" },
        new() { Name = "ShowHeader", Type = "bool", Default = "true", Description = "ShowHeader parameter" },
        new() { Name = "StickyHeader", Type = "bool", Default = "true", Description = "StickyHeader parameter" },
        new() { Name = "HeaderShadow", Type = "bool", Default = "true", Description = "HeaderShadow parameter" },
        new() { Name = "MenuOpenByDefault", Type = "bool", Default = "true", Description = "MenuOpenByDefault parameter" },
        new() { Name = "MenuOpenOnMobileByDefault", Type = "bool", Default = "false", Description = "MenuOpenOnMobileByDefault parameter" },
        new() { Name = "AutoHideOnMobileAfterNavigation", Type = "bool", Default = "true", Description = "AutoHideOnMobileAfterNavigation parameter" },
        new() { Name = "LayoutMode", Type = "LayoutMode", Default = "LayoutMode.DrawerLeft", Description = "LayoutMode parameter" },
        new() { Name = "Density", Type = "DensityMode", Default = "DensityMode.Normal", Description = "Density parameter" },
        new() { Name = "HideScrollbars", Type = "bool", Default = "true", Description = "HideScrollbars parameter" },
    };
}
