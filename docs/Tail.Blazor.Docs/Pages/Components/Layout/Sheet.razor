@page "/components/sheet"
@using Tail.Blazor.Docs.Shared

<PageTitle>Sheet - Tail.Blazor</PageTitle>

<DocPageTemplate Title="TailSheet" 
                 Description="A bottom sheet component for displaying additional content or actions." 
                 PackageName="Tail.Blazor.Layout"
                 ApiParameters="@apiParameters">
    <DocSection Title="Installation">
        <CodePreview Title="Install Package" Code="@installCode" />
    </DocSection>
    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Sheet" Code="@basicCode">
            <PreviewContent>
                <!-- Component preview will be rendered here -->
            </PreviewContent>
        </CodePreview>
    </DocSection>
</DocPageTemplate>

@code {
    private string installCode = @"dotnet add package Tail.Blazor.Sheet";
    private string basicCode = @"<TailSheet Open=""true"" Title=""Sheet Title"">
    Content goes here
</TailSheet>";
    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new DocPageTemplate.ApiParameter { Name = "Open", Type = "bool", Description = "Whether sheet is open", Default = "false" },
        new DocPageTemplate.ApiParameter { Name = "Title", Type = "string", Description = "Sheet title", Default = "" },
        new DocPageTemplate.ApiParameter { Name = "Position", Type = "string", Description = "bottom, top, left, right", Default = "bottom" }
    };
}
