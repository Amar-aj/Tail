@page "/components/layout/collapsiblemenu"
@using Tail.Blazor.CollapsibleMenu
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="CollapsibleMenu"
                 Description="CollapsibleMenu component for Tail.Blazor"
                 PackageName="Tail.Blazor.CollapsibleMenu"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailCollapsibleMenu />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.CollapsibleMenu";

    private string basicCode = @"<TailCollapsibleMenu />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Title", Type = "string", Default = "string.Empty", Description = "Title parameter" },
    };
}
