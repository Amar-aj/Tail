@page "/components/buttons/buttongroup"
@using Tail.Blazor.ButtonGroup
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="ButtonGroup"
                 Description="ButtonGroup component for Tail.Blazor"
                 PackageName="Tail.Blazor.ButtonGroup"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Horizontal and vertical layouts</li>
            <li>Seamless button grouping</li>
            <li>Rounded corners</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailButtonGroup>Content</TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Quick Start">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Get up and running in seconds.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailButtonGroup>
                            Hello, World!
                        </TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@quickstartCode" CodeElementId="quickstart-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Common Patterns">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Frequently used patterns and combinations.
        </p>
        <CodePreview Code="@patternsCode" CodeElementId="patterns-code" />
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailButtonGroup Variant="string?.Primary">Primary</TailButtonGroup>
                    <TailButtonGroup Variant="string?.Success">Success</TailButtonGroup>
                    <TailButtonGroup Variant="string?.Warning">Warning</TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@variantsCode" CodeElementId="variants-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailButtonGroup Size="Tail.Blazor.ButtonGroup.ButtonGroupSize.Xs">Xs</TailButtonGroup>
                    <TailButtonGroup Size="Tail.Blazor.ButtonGroup.ButtonGroupSize.Sm">Sm</TailButtonGroup>
                    <TailButtonGroup Size="Tail.Blazor.ButtonGroup.ButtonGroupSize.Md">Md</TailButtonGroup>
                    <TailButtonGroup Size="Tail.Blazor.ButtonGroup.ButtonGroupSize.Lg">Lg</TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="States">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Component states for different interaction scenarios.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailButtonGroup Disabled="true">Disabled</TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@statesCode" CodeElementId="states-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Parameter Combinations">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Combine multiple parameters for advanced usage.
        </p>
        <CodePreview Code="@combinationsCode" CodeElementId="combinations-code" />
    </DocSection>

    <DocSection Title="Advanced Examples">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            More complex usage scenarios.
        </p>
        <CodePreview Code="@advancedCode" CodeElementId="advanced-code" />
    </DocSection>

    <DocSection Title="Real-World Example">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            A complete example showing practical usage.
        </p>
        <CodePreview Code="@realworldCode" CodeElementId="realworld-code" />
    </DocSection>

