@page "/components/buttons/buttongroup"
@using Tail.Blazor.ButtonGroup
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="ButtonGroup"
                 Description="ButtonGroup component for Tail.Blazor"
                 PackageName="Tail.Blazor.ButtonGroup"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailButtonGroup>Click Me</TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailButtonGroup>Small</TailButtonGroup>
<TailButtonGroup>Medium</TailButtonGroup>
<TailButtonGroup>Large</TailButtonGroup>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ButtonGroup";

    private string basicCode = @"<TailButtonGroup>Click Me</TailButtonGroup>";

    private string sizesCode = @"
<TailButtonGroup>Small</TailButtonGroup>
<TailButtonGroup>Medium</TailButtonGroup>
<TailButtonGroup>Large</TailButtonGroup>
";

    private string statesCode = @"
<TailButtonGroup Disabled=""true"">Disabled</TailButtonGroup>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Spacing", Type = "ButtonGroupSpacing", Default = "ButtonGroupSpacing.None", Description = "Spacing parameter" },
        new() { Name = "Size", Type = "ButtonGroupSize", Default = "ButtonGroupSize.Md", Description = "Size of the component" },
        new() { Name = "BorderRadius", Type = "ButtonGroupBorderRadius", Default = "ButtonGroupBorderRadius.Md", Description = "BorderRadius parameter" },
        new() { Name = "Attached", Type = "bool", Default = "true", Description = "Attached parameter" },
        new() { Name = "ShowBorder", Type = "bool", Default = "true", Description = "ShowBorder parameter" },
        new() { Name = "ShowShadow", Type = "bool", Default = "false", Description = "ShowShadow parameter" },
        new() { Name = "Disabled", Type = "bool", Default = "false", Description = "Whether the component is disabled" },
        new() { Name = "AnimationDuration", Type = "string", Default = """duration-200""", Description = "AnimationDuration parameter" },
        new() { Name = "ResponsiveVertical", Type = "bool", Default = "false", Description = "ResponsiveVertical parameter" },
    };
}
