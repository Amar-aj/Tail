        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.SplitButton";

    private string basicCode = @"<TailSplitButton></TailSplitButton>";

    private string variantsCode = @"
<TailSplitButton Variant=""Tail.Blazor.SplitButton.ButtonVariant.Primary"">Primary</TailSplitButton>
<TailSplitButton Variant=""Tail.Blazor.SplitButton.ButtonVariant.Success"">Success</TailSplitButton>
<TailSplitButton Variant=""Tail.Blazor.SplitButton.ButtonVariant.Warning"">Warning</TailSplitButton>
";

    private string sizesCode = @"
<TailSplitButton Size=""Tail.Blazor.SplitButton.ButtonSize.Sm"">Small</TailSplitButton>
<TailSplitButton Size=""Tail.Blazor.SplitButton.ButtonSize.Md"">Medium</TailSplitButton>
<TailSplitButton Size=""Tail.Blazor.SplitButton.ButtonSize.Lg"">Large</TailSplitButton>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "PrimaryContent", Type = "RenderFragment?", Default = "-", Description = "PrimaryContent parameter" },
        new() { Name = "DropdownContent", Type = "RenderFragment?", Default = "-", Description = "DropdownContent parameter" },
        new() { Name = "DropdownIcon", Type = "RenderFragment?", Default = "-", Description = "Icon to display" },
        new() { Name = "Variant", Type = "ButtonVariant", Default = "ButtonVariant.Primary", Description = "Visual variant style for the component" },
        new() { Name = "Size", Type = "ButtonSize", Default = "ButtonSize.Md", Description = "Size of the component" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "IsLoading", Type = "bool", Default = "-", Description = "Whether the component is in loading state" },
        new() { Name = "Type", Type = "string", Default = """button""", Description = "Type parameter" },
        new() { Name = "AriaLabel", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "Tooltip", Type = "string?", Default = "-", Description = "Tooltip parameter" },
    };
}
