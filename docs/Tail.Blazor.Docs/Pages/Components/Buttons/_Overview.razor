@page "/components/buttons"

<PageTitle>Buttons Components - Tail.Blazor</PageTitle>

<div class="container mx-auto px-4 py-12">
    <div class="mb-8">
        <a href="/components" class="text-blue-600 hover:text-blue-700 text-sm font-medium">&larr; All Components</a>
        <h1 class="text-4xl font-bold mt-2">Buttons Components</h1>
        <p class="text-gray-600 text-lg mt-2">A collection of 6 buttons components for Tail.Blazor.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <a href="/components/buttons/button" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.Button</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/buttons/buttongroup" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.ButtonGroup</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/buttons/fab" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.FAB</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/buttons/iconbutton" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.IconButton</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/buttons/splitbutton" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.SplitButton</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/buttons/togglebutton" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.ToggleButton</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
    </div>
</div>

