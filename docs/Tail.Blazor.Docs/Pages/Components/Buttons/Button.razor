@page "/components/buttons/button"
@using Tail.Blazor.Button
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Button"
                 Description="Button component for Tail.Blazor"
                 PackageName="Tail.Blazor.Button"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs>
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailButton>Click Me</TailButton>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <TailTabs>
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailButton>Default</TailButton>
<TailButton>Variant 1</TailButton>
<TailButton>Variant 2</TailButton>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@variantsCode" CodeElementId="variants-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs>
            <TailTabPanel Label="Preview" IsActive="true">
                <PreviewUI>
                    <TailButton>Small</TailButton>
<TailButton>Medium</TailButton>
<TailButton>Large</TailButton>
                </PreviewUI>
            </TailTabPanel>
            <TailTabPanel Label="Code">
                <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
            </TailTabPanel>
        </TailTabs>
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Button";

    private string basicCode = @"<TailButton>Click Me</TailButton>";

    private string variantsCode = @"
<TailButton>Default</TailButton>
<TailButton>Variant 1</TailButton>
<TailButton>Variant 2</TailButton>
";

    private string sizesCode = @"
<TailButton>Small</TailButton>
<TailButton>Medium</TailButton>
<TailButton>Large</TailButton>
";

    private string statesCode = @"
<TailButton IsLoading=""true"">Loading</TailButton>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Variant", Type = "ButtonVariant", Default = "ButtonVariant.Primary", Description = "Visual variant style for the component" },
        new() { Name = "Size", Type = "ButtonSize", Default = "ButtonSize.Md", Description = "Size of the component" },
        new() { Name = "ShowDefaultLoadingText", Type = "bool", Default = "false", Description = "Whether the component is in loading state" },
        new() { Name = "DefaultLoadingText", Type = "string", Default = """Loading...""", Description = "Whether the component is in loading state" },
        new() { Name = "Type", Type = "string", Default = """button""", Description = "Type parameter" },
        new() { Name = "EnableRipple", Type = "bool", Default = "true", Description = "EnableRipple parameter" },
        new() { Name = "FullWidth", Type = "bool", Default = "false", Description = "FullWidth parameter" },
        new() { Name = "AnimationDuration", Type = "string", Default = """duration-200""", Description = "AnimationDuration parameter" },
        new() { Name = "AutoFocus", Type = "bool", Default = "false", Description = "AutoFocus parameter" },
    };
}
