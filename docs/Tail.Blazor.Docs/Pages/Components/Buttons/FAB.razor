@page "/components/buttons/fab"
@using Tail.Blazor.FAB
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="FAB"
                 Description="FAB component for Tail.Blazor"
                 PackageName="Tail.Blazor.FAB"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>4 positions (TopLeft, TopRight, BottomLeft, BottomRight)</li>
            <li>Fixed positioning</li>
            <li>Circular design</li>
            <li>Loading states</li>
            <li>Disabled states</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailFAB>Content</TailFAB>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Quick Start">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Get up and running in seconds.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailFAB>
                            Hello, World!
                        </TailFAB>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@quickstartCode" CodeElementId="quickstart-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Common Patterns">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Frequently used patterns and combinations.
        </p>
        <CodePreview Code="@patternsCode" CodeElementId="patterns-code" />
    </DocSection>

    <DocSection Title="States">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Component states for different interaction scenarios.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailFAB Disabled="true">Disabled</TailFAB>

                    <TailFAB IsLoading="true">Loading...</TailFAB>

                    <TailFAB Disabled="true" IsLoading="true">Processing</TailFAB>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@statesCode" CodeElementId="states-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Event Handling">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Handle user interactions with event callbacks.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailFAB>
                        Click Me
                    </TailFAB>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@eventsCode" CodeElementId="events-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Parameter Combinations">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Combine multiple parameters for advanced usage.
        </p>
        <CodePreview Code="@combinationsCode" CodeElementId="combinations-code" />
    </DocSection>

    <DocSection Title="Advanced Examples">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            More complex usage scenarios.
        </p>
        <CodePreview Code="@advancedCode" CodeElementId="advanced-code" />
    </DocSection>

    <DocSection Title="Real-World Example">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            A complete example showing practical usage.
        </p>
        <CodePreview Code="@realworldCode" CodeElementId="realworld-code" />
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ChildContent</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>RenderFragment?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ChildContent parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Position</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FABPosition</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FABPosition.BottomRight</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Position parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Disabled</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Whether the component is disabled</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IsLoading</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Whether the component is in loading state</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Type</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">"button"</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Type parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Style</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Additional CSS styles</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>AutoFocus</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">false</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AutoFocus parameter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnClick</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>MouseEventArgs</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when component is clicked</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.FAB";

    private string basicCode = @"<TailFAB>Content</TailFAB>";

    private string statesCode = @"
@* Disabled state *@
<TailFAB Disabled=""true"">Disabled</TailFAB>

@* Loading state *@
<TailFAB IsLoading=""true"">Loading...</TailFAB>

@* Both disabled and loading *@
<TailFAB Disabled=""true"" IsLoading=""true"">Processing</TailFAB>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.FAB

<TailFAB>
    Hello, World!
</TailFAB>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**With Click Handler**

```razor
<TailFAB OnClick=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailFAB>
```

**Disabled State**

```razor
<TailFAB Disabled=""true"">
    Disabled
</TailFAB>
```
";

    private string eventsCode = @"
<TailFAB OnClick=""HandleOnClick"">
    Click Me
</TailFAB>

@code {
    private void HandleOnClick(MouseEventArgs args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailFAB Type=""Sample Type"">
    Combined Parameters
</TailFAB>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailFAB OnClick=""HandleAction"">
        Action Button
    </TailFAB>
</div>

@code {
    private void HandleAction(MouseEventArgs args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
        new() { Name = "Position", Type = "FABPosition", Default = "FABPosition.BottomRight", Description = "Position parameter" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "IsLoading", Type = "bool", Default = "-", Description = "Whether the component is in loading state" },
        new() { Name = "Type", Type = "string", Default = """button""", Description = "Type parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
        new() { Name = "AutoFocus", Type = "bool", Default = "false", Description = "AutoFocus parameter" },
    };
}
