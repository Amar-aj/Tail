@page "/components/navigation/bottomnavigation"
@using Tail.Blazor.Docs.Shared

<DocPageTemplate Title="BottomNavigation"
                 Description="BottomNavigation component for Tail.Blazor"
                 PackageName="Tail.Blazor.BottomNavigation"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Title="Package Installation" Code="@installCode" ShowPreview="false" Language="bash" />
