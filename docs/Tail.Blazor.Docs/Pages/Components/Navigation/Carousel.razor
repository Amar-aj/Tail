@page "/components/navigation/carousel"
@using Tail.Blazor.Carousel
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Carousel"
                 Description="Carousel component for Tail.Blazor"
                 PackageName="Tail.Blazor.Carousel"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Image/content carousel</li>
            <li>Previous/Next controls</li>
            <li>Indicator dots</li>
            <li>Auto-play option</li>
            <li>Smooth transitions</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailCarousel>Content</TailCarousel>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Quick Start">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Get up and running in seconds.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailCarousel>
                            Hello, World!
                        </TailCarousel>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@quickstartCode" CodeElementId="quickstart-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Common Patterns">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Frequently used patterns and combinations.
        </p>
        <CodePreview Code="@patternsCode" CodeElementId="patterns-code" />
    </DocSection>

    <DocSection Title="Parameter Combinations">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Combine multiple parameters for advanced usage.
        </p>
        <CodePreview Code="@combinationsCode" CodeElementId="combinations-code" />
    </DocSection>

    <DocSection Title="Advanced Examples">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            More complex usage scenarios.
        </p>
        <CodePreview Code="@advancedCode" CodeElementId="advanced-code" />
    </DocSection>

    <DocSection Title="Real-World Example">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            A complete example showing practical usage.
        </p>
        <CodePreview Code="@realworldCode" CodeElementId="realworld-code" />
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Items</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;RenderFragment&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Data items collection</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>CurrentIndex</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">CurrentIndex parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowControls</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowControls parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowIndicators</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowIndicators parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>AutoPlay</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AutoPlay parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>AutoPlayInterval</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">3000</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AutoPlayInterval parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Style</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Additional CSS styles</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Public Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Property</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Dispose</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>void</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Dispose property</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Carousel";

    private string basicCode = @"<TailCarousel>Content</TailCarousel>";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.Carousel

<TailCarousel>
    Hello, World!
</TailCarousel>
";

    private string patternsCode = @"
Frequently used patterns and combinations:
";

    private string combinationsCode = @"
<TailCarousel CurrentIndex=""10"" ShowControls=""true"" ShowIndicators=""true"" AutoPlay=""true"">
    Combined Parameters
</TailCarousel>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailCarousel >
        Action Button
    </TailCarousel>
</div>

@code {
    // Component logic here
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Items", Type = "List<RenderFragment>", Default = "new()", Description = "Data items collection" },
        new() { Name = "CurrentIndex", Type = "int", Default = "-", Description = "CurrentIndex parameter" },
        new() { Name = "ShowControls", Type = "bool", Default = "true", Description = "ShowControls parameter" },
        new() { Name = "ShowIndicators", Type = "bool", Default = "true", Description = "ShowIndicators parameter" },
        new() { Name = "AutoPlay", Type = "bool", Default = "-", Description = "AutoPlay parameter" },
        new() { Name = "AutoPlayInterval", Type = "int", Default = "3000", Description = "AutoPlayInterval parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
