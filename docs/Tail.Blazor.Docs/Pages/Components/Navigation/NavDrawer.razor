@page "/components/navdrawer"
@using Tail.Blazor.Docs.Shared

<PageTitle>NavDrawer - Tail.Blazor</PageTitle>

<DocPageTemplate Title="TailNavDrawer" 
                 Description="A sliding navigation drawer component for mobile and desktop layouts." 
                 PackageName="Tail.Blazor.Navigation"
                 ApiParameters="@apiParameters">
    <DocSection Title="Installation">
        <CodePreview Title="Install Package" Code="@installCode" />
    </DocSection>
    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic NavDrawer" Code="@basicCode">
            <PreviewContent>
                <!-- Component preview will be rendered here -->
            </PreviewContent>
        </CodePreview>
    </DocSection>
</DocPageTemplate>

@code {
    private string installCode = @"dotnet add package Tail.Blazor.NavDrawer";
    private string basicCode = @"<TailNavDrawer Open=""true"" Position=""left"">
    <TailNavDrawerItem Href=""/"" Text=""Home"" />
    <TailNavDrawerItem Href=""/about"" Text=""About"" />
</TailNavDrawer>";
    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new DocPageTemplate.ApiParameter { Name = "Open", Type = "bool", Description = "Whether drawer is open", Default = "false" },
        new DocPageTemplate.ApiParameter { Name = "Position", Type = "string", Description = "left or right", Default = "left" }
    };
}
