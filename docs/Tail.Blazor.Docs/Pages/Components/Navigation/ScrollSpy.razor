@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ScrollSpy";

    private string basicCode = @"<TailScrollSpy />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.ScrollSpy

<TailScrollSpy />
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**With Click Handler**

```razor
<TailScrollSpy OnItemClick=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailScrollSpy>
```
";

    private string eventsCode = @"
<TailScrollSpy OnItemClick=""HandleOnItemClick"">
    Click Me
</TailScrollSpy>

@code {
    private void HandleOnItemClick(Tail.Blazor.ScrollSpy.ScrollSpyItem args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailScrollSpy ActiveId=""Sample ActiveId"" Style=""Sample Style"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailScrollSpy OnItemClick=""HandleAction"" />
</div>

@code {
    private void HandleAction(ScrollSpyItem args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Items", Type = "List<ScrollSpyItem>", Default = "new()", Description = "Data items collection" },
        new() { Name = "ActiveId", Type = "string?", Default = "-", Description = "ActiveId parameter" },
        new() { Name = "Position", Type = "ScrollSpyPosition", Default = "ScrollSpyPosition.Left", Description = "Position parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
