        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ScrollSpy";

    private string basicCode = @"<TailScrollSpy></TailScrollSpy>";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Items", Type = "List<ScrollSpyItem>", Default = "new()", Description = "Data items collection" },
        new() { Name = "ActiveId", Type = "string?", Default = "-", Description = "ActiveId parameter" },
        new() { Name = "Position", Type = "ScrollSpyPosition", Default = "ScrollSpyPosition.Left", Description = "Position parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
