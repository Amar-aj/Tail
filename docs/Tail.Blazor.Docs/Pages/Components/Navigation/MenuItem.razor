@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.MenuItem";

    private string basicCode = @"<TailMenuItem>Content</TailMenuItem>";

    private string statesCode = @"
@* Disabled state *@
<TailMenuItem Disabled=""true"">Disabled</TailMenuItem>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.MenuItem

<TailMenuItem>
    Hello, World!
</TailMenuItem>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**With Click Handler**

```razor
<TailMenuItem OnClick=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailMenuItem>
```

**Disabled State**

```razor
<TailMenuItem Disabled=""true"">
    Disabled
</TailMenuItem>
```
";

    private string eventsCode = @"
<TailMenuItem OnClick=""HandleOnClick"">
    Click Me
</TailMenuItem>

@code {
    private void HandleOnClick(Tail.Blazor.MenuItem.MenuItemClickArgs args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailMenuItem Href=""Sample Href"" IsActive=""true"">
    Combined Parameters
</TailMenuItem>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailMenuItem OnClick=""HandleAction"">
        Action Button
    </TailMenuItem>
</div>

@code {
    private void HandleAction(MenuItemClickArgs args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
