        new() { Name = "Href", Type = "string?", Default = """#""", Description = "Href parameter" },
        new() { Name = "IsActive", Type = "bool", Default = "-", Description = "IsActive parameter" },
        new() { Name = "Target", Type = "string?", Default = "-", Description = "Target parameter" },
        new() { Name = "Disabled", Type = "bool", Default = "false", Description = "Whether the component is disabled" },
        new() { Name = "PreventDefault", Type = "bool", Default = "true", Description = "PreventDefault parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
        new() { Name = "ItemClass", Type = "string?", Default = "-", Description = "Additional CSS classes" },
        new() { Name = "Bordered", Type = "bool", Default = "false", Description = "Bordered parameter" },
