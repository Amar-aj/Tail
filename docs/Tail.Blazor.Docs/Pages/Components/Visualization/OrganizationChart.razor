</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.OrganizationChart";

    private string basicCode = @"<TailOrganizationChart />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "RootNode", Type = "OrganizationNode", Default = "default!", Description = "RootNode parameter" },
    };
}
