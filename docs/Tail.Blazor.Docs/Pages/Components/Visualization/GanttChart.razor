@page "/components/visualization/ganttchart"
@using Tail.Blazor.GanttChart
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="GanttChart"
                 Description="GanttChart component for Tail.Blazor"
                 PackageName="Tail.Blazor.GanttChart"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailGanttChart />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.GanttChart";

    private string basicCode = @"<TailGanttChart />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Tasks", Type = "List<GanttTask>", Default = "new()", Description = "Tasks parameter" },
        new() { Name = "StartDate", Type = "DateTime", Default = "DateTime.Now", Description = "StartDate parameter" },
        new() { Name = "EndDate", Type = "DateTime", Default = "DateTime.Now.AddDays(30)", Description = "EndDate parameter" },
    };
}
