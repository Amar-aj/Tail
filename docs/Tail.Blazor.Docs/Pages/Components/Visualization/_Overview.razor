@page "/components/visualization"
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Container
@using Tail.Blazor.Card
@using Tail.Blazor.Badge

<TailContainer Size="ContainerSize.Full" Class="py-8">
    <div class="mb-8">
        <a href="/components" class="text-blue-600 hover:text-blue-700">← Components</a>
        <h1 class="text-4xl font-bold mt-2 mb-2">🎨 Visualization Components</h1>
        <p class="text-gray-600">A collection of 6 visualization components</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        <a href="/components/visualization/arcgauge" class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
        <h4 class="font-semibold text-gray-800">ArcGauge</h4>
        <p class="text-xs text-gray-500 mt-1">Tail.Blazor.ArcGauge</p>
        <div class="mt-2">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800">
                ⊘ Pending
            </span>
        </div>
    </a>
    <a href="/components/visualization/flowchart" class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
        <h4 class="font-semibold text-gray-800">Flowchart</h4>
        <p class="text-xs text-gray-500 mt-1">Tail.Blazor.Flowchart</p>
        <div class="mt-2">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800">
                ⊘ Pending
            </span>
        </div>
    </a>
    <a href="/components/visualization/ganttchart" class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
        <h4 class="font-semibold text-gray-800">GanttChart</h4>
        <p class="text-xs text-gray-500 mt-1">Tail.Blazor.GanttChart</p>
        <div class="mt-2">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800">
                ⊘ Pending
            </span>
        </div>
    </a>
    <a href="/components/visualization/organizationchart" class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
        <h4 class="font-semibold text-gray-800">OrganizationChart</h4>
        <p class="text-xs text-gray-500 mt-1">Tail.Blazor.OrganizationChart</p>
        <div class="mt-2">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800">
                ⊘ Pending
            </span>
        </div>
    </a>
    <a href="/components/visualization/qrcode" class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
        <h4 class="font-semibold text-gray-800">QRCode</h4>
        <p class="text-xs text-gray-500 mt-1">Tail.Blazor.QRCode</p>
        <div class="mt-2">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800">
                ⊘ Pending
            </span>
        </div>
    </a>
    <a href="/components/visualization/timeline" class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
        <h4 class="font-semibold text-gray-800">Timeline</h4>
        <p class="text-xs text-gray-500 mt-1">Tail.Blazor.Timeline</p>
        <div class="mt-2">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800">
                ⊘ Pending
            </span>
        </div>
    </a>
    </div>

    <TailCard Class="mt-8">
        <Header>
            <h2 class="text-2xl font-bold">Statistics</h2>
        </Header>
        <ChildContent>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="p-4 bg-blue-50 rounded-lg">
                    <div class="text-2xl font-bold text-blue-600">6</div>
                    <p class="text-sm text-gray-600">Total Components</p>
                </div>
                <div class="p-4 bg-green-50 rounded-lg">
                    <div class="text-2xl font-bold text-green-600">0</div>
                    <p class="text-sm text-gray-600">Implemented</p>
                </div>
                <div class="p-4 bg-yellow-50 rounded-lg">
                    <div class="text-2xl font-bold text-yellow-600">6</div>
                    <p class="text-sm text-gray-600">Pending</p>
                </div>
                <div class="p-4 bg-purple-50 rounded-lg">
                    <div class="text-2xl font-bold text-purple-600">100%</div>
                    <p class="text-sm text-gray-600">Coverage</p>
                </div>
            </div>
        </ChildContent>
    </TailCard>
</TailContainer>

