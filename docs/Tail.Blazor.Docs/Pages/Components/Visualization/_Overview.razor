@page "/components/visualization"

<PageTitle>Visualization Components - Tail.Blazor</PageTitle>

<div class="container mx-auto px-4 py-12">
    <div class="mb-8">
        <a href="/components" class="text-blue-600 hover:text-blue-700 text-sm font-medium">&larr; All Components</a>
        <h1 class="text-4xl font-bold mt-2">Visualization Components</h1>
        <p class="text-gray-600 text-lg mt-2">A collection of 6 visualization components for Tail.Blazor.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <a href="/components/visualization/arcgauge" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.ArcGauge</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/visualization/flowchart" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.Flowchart</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/visualization/ganttchart" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.GanttChart</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/visualization/organizationchart" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.OrganizationChart</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/visualization/qrcode" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.QRCode</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
            <a href="/components/visualization/timeline" class="block p-4 border rounded-lg hover:shadow-lg hover:border-blue-400 transition">
                <h3 class="font-bold text-lg">Tail.Blazor.Timeline</h3>
                <p class="text-gray-600 text-sm">Click to view documentation</p>
            </a>
    </div>
</div>

