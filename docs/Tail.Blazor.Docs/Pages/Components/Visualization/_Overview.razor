@page "/components/visualization"
@using Tail.Blazor.Docs.Shared

<PageTitle>Visualization Components - Tail.Blazor</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Category Header -->
    <div class="mb-8">
        <div class="flex items-center mb-4">
            <span class="text-5xl mr-4">🎨</span>
            <div>
                <h1 class="text-4xl font-bold" style="color: var(--color-text-primary);">
                    Visualization Components
                </h1>
                <p class="text-lg mt-2" style="color: var(--color-text-secondary);">
                    6 components with 21+ parameters
                </p>
            </div>
        </div>
    </div>

    <!-- Components Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- ArcGauge Component -->
        <a href="/components/visualization/arcgauge" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    ArcGauge
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                Independent NuGet package for the TailArcGauge component.
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>5 parameters</span>
                <span class="font-mono">Tail.Blazor.ArcGauge</span>
            </div>
        </a>

        <!-- Flowchart Component -->
        <a href="/components/visualization/flowchart" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    Flowchart
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                Independent NuGet package for the TailFlowchart component.
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>5 parameters</span>
                <span class="font-mono">Tail.Blazor.Flowchart</span>
            </div>
        </a>

        <!-- GanttChart Component -->
        <a href="/components/visualization/ganttchart" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    GanttChart
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                Independent NuGet package for the TailGanttChart component.
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>4 parameters</span>
                <span class="font-mono">Tail.Blazor.GanttChart</span>
            </div>
        </a>

        <!-- OrganizationChart Component -->
        <a href="/components/visualization/organizationchart" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    OrganizationChart
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                Independent NuGet package for the TailOrganizationChart component.
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>2 parameters</span>
                <span class="font-mono">Tail.Blazor.OrganizationChart</span>
            </div>
        </a>

        <!-- QRCode Component -->
        <a href="/components/visualization/qrcode" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    QRCode
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                Independent NuGet package for the TailQRCode component.
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>3 parameters</span>
                <span class="font-mono">Tail.Blazor.QRCode</span>
            </div>
        </a>

        <!-- Timeline Component -->
        <a href="/components/visualization/timeline" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    Timeline
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                Independent NuGet package for the TailTimeline component.
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>2 parameters</span>
                <span class="font-mono">Tail.Blazor.Timeline</span>
            </div>
        </a>

    </div>

    <!-- Category Navigation -->
    <div class="mt-8 flex justify-between items-center">
        <a href="/components" class="text-sm hover:underline" style="color: var(--color-primary);">
            ← Back to All Components
        </a>
        <div class="text-sm" style="color: var(--color-text-secondary);">
            Total: 6 components
        </div>
    </div>
</div>
