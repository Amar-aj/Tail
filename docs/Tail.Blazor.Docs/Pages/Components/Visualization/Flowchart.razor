                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Label property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>X</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">X property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Y</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Y property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FlowchartConnection</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>class</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FlowchartConnection property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FromId</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FromId property</td>
                        </tr>
                        <tr>
