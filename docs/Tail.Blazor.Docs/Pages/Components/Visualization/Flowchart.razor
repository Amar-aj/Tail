                            <td style="padding: 10px; border: 1px solid var(--color-border);">ToId property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FromX</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FromX property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FromY</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FromY property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ToX</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ToX property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ToY</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ToY property</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Flowchart";

    private string basicCode = @"<TailFlowchart></TailFlowchart>";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Nodes", Type = "List<FlowchartNode>", Default = "new()", Description = "Nodes parameter" },
        new() { Name = "Connections", Type = "List<FlowchartConnection>", Default = "new()", Description = "Connections parameter" },
        new() { Name = "Width", Type = "int", Default = "800", Description = "Width parameter" },
        new() { Name = "Height", Type = "int", Default = "600", Description = "Height parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
