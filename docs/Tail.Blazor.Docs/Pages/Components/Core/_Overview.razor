@page "/components/core"
@using Tail.Blazor.Docs.Shared

<PageTitle>Core Components - Tail.Blazor</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Category Header -->
    <div class="mb-8">
        <div class="flex items-center mb-4">
            <span class="text-5xl mr-4">⚙️</span>
            <div>
                <h1 class="text-4xl font-bold" style="color: var(--color-text-primary);">
                    Core Components
                </h1>
                <p class="text-lg mt-2" style="color: var(--color-text-secondary);">
                    3 components with 4+ parameters
                </p>
            </div>
        </div>
    </div>

    <!-- Components Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Core Component -->
        <a href="/components/core/core" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    Core
                </h3>
                <span class="text-xs px-2 py-1 rounded" style="background-color: var(--color-surface-3); color: var(--color-text-secondary);">Coming Soon</span>
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>0 parameters</span>
                <span class="font-mono">Tail.Blazor.Core</span>
            </div>
        </a>

        <!-- Core.Base Component -->
        <a href="/components/core/core.base" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    Core.Base
                </h3>
                <span class="text-xs px-2 py-1 rounded" style="background-color: var(--color-surface-3); color: var(--color-text-secondary);">Coming Soon</span>
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>0 parameters</span>
                <span class="font-mono">Tail.Blazor.Core.Base</span>
            </div>
        </a>

        <!-- Core.Theme Component -->
        <a href="/components/core/core.theme" 
           class="block p-6 rounded-lg border-2 transition-all hover:shadow-lg hover:border-opacity-70"
           style="background-color: var(--color-surface-1); border-color: var(--color-border); text-decoration: none;">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-semibold" style="color: var(--color-text-primary);">
                    Core.Theme
                </h3>
                
            </div>
            <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                
            </p>
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-tertiary);">
                <span>4 parameters</span>
                <span class="font-mono">Tail.Blazor.Core.Theme</span>
            </div>
        </a>

    </div>

    <!-- Category Navigation -->
    <div class="mt-8 flex justify-between items-center">
        <a href="/components" class="text-sm hover:underline" style="color: var(--color-primary);">
            ← Back to All Components
        </a>
        <div class="text-sm" style="color: var(--color-text-secondary);">
            Total: 3 components
        </div>
    </div>
</div>
