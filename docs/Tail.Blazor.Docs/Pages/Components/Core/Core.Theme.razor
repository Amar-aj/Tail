@page "/components/core/core.theme"
@using Tail.Blazor.Core.Theme
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Core.Theme"
                 Description="Core.Theme component for Tail.Blazor"
                 PackageName="Tail.Blazor.Core.Theme"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailCore.Theme />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Core.Theme";

    private string basicCode = @"<TailCore.Theme />";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ShowModeToggle", Type = "bool", Default = "true", Description = "ShowModeToggle parameter" },
        new() { Name = "ShowThemeSelector", Type = "bool", Default = "true", Description = "ShowThemeSelector parameter" },
        new() { Name = "ShowThemeName", Type = "bool", Default = "false", Description = "ShowThemeName parameter" },
        new() { Name = "Style", Type = "DisplayStyle", Default = "DisplayStyle.Inline", Description = "Additional CSS styles" },
    };
}
