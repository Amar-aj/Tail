@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.AudioRecorder";

    private string basicCode = @"<TailAudioRecorder />";

    private string sizesCode = @"
<TailAudioRecorder Size=""AudioRecorderSize.Xs"">Xs</TailAudioRecorder>
<TailAudioRecorder Size=""AudioRecorderSize.Sm"">Sm</TailAudioRecorder>
<TailAudioRecorder Size=""AudioRecorderSize.Md"">Md</TailAudioRecorder>
<TailAudioRecorder Size=""AudioRecorderSize.Lg"">Lg</TailAudioRecorder>
";

    private string statesCode = @"
@* Disabled state *@
<TailAudioRecorder Disabled=""true"">Disabled</TailAudioRecorder>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.AudioRecorder

<TailAudioRecorder />
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Medium Size**

```razor
<TailAudioRecorder Size=""AudioRecorderSize.Md"">
    Medium Size
</TailAudioRecorder>
```

**With Click Handler**

```razor
<TailAudioRecorder ValueChanged=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailAudioRecorder>
```

**Disabled State**

```razor
<TailAudioRecorder Disabled=""true"">
    Disabled
</TailAudioRecorder>
```
";

    private string eventsCode = @"
<TailAudioRecorder ValueChanged=""HandleValueChanged"">
    Click Me
</TailAudioRecorder>

@code {
    private void HandleValueChanged(string? args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailAudioRecorder Size=""AudioRecorderSize.Sm"" Value=""Sample Value"" Label=""Sample Label"" MaxRecordingTime=""10"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailAudioRecorder Size=""AudioRecorderSize.Sm"" ValueChanged=""HandleAction"" />
</div>

@code {
    private void HandleAction(string? args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "string?", Default = "-", Description = "Current value of the component" },
