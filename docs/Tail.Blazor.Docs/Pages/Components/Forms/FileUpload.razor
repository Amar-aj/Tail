@page "/components/forms/fileupload"
@using Tail.Blazor.FileUpload
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="FileUpload"
                 Description="FileUpload component for Tail.Blazor"
                 PackageName="Tail.Blazor.FileUpload"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs>
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailFileUpload Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs>
            <TailTabPanel Label="Preview" IsActive="true">
                <PreviewUI>
                    <TailFileUpload>Small</TailFileUpload>
<TailFileUpload>Medium</TailFileUpload>
<TailFileUpload>Large</TailFileUpload>
                </PreviewUI>
            </TailTabPanel>
            <TailTabPanel Label="Code">
                <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
            </TailTabPanel>
        </TailTabs>
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.FileUpload";

    private string basicCode = @"<TailFileUpload Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailFileUpload>Small</TailFileUpload>
<TailFileUpload>Medium</TailFileUpload>
<TailFileUpload>Large</TailFileUpload>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "FileUploadSize", Default = "FileUploadSize.Md", Description = "Size of the component" },
        new() { Name = "MaxFiles", Type = "int", Default = "5", Description = "Maximum value constraint" },
        new() { Name = "MaxFileSize", Type = "long", Default = "10 * 1024 * 1024", Description = "Size of the component" },
        new() { Name = "ShowPreview", Type = "bool", Default = "true", Description = "ShowPreview parameter" },
        new() { Name = "AutoUpload", Type = "bool", Default = "false", Description = "AutoUpload parameter" },
        new() { Name = "ShowUploadButton", Type = "bool", Default = "true", Description = "ShowUploadButton parameter" },
        new() { Name = "ShowRemoveButton", Type = "bool", Default = "true", Description = "ShowRemoveButton parameter" },
        new() { Name = "ShowRemoveAll", Type = "bool", Default = "true", Description = "ShowRemoveAll parameter" },
    };
}
