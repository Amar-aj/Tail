@page "/components/forms/fileupload"
@using Tail.Blazor.FileUpload
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="FileUpload"
                 Description="FileUpload component for Tail.Blazor"
                 PackageName="Tail.Blazor.FileUpload"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailFileUpload Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailFileUpload>Small</TailFileUpload>
<TailFileUpload>Medium</TailFileUpload>
<TailFileUpload>Large</TailFileUpload>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Size</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FileUploadSize</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">FileUploadSize.Md</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>MaxFiles</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">5</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Maximum value constraint</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>MaxFileSize</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>long</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">10 * 1024 * 1024</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowPreview</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowPreview parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>AutoUpload</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">false</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AutoUpload parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowUploadButton</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowUploadButton parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowRemoveButton</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowRemoveButton parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowRemoveAll</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowRemoveAll parameter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FilesChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IBrowserFile[]</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FilesSelected</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IBrowserFile[]</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised with IBrowserFile[] value</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>UploadRequested</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IBrowserFile[]</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised with IBrowserFile[] value</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Public Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Property</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>File</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>IBrowserFile</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">File property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>PreviewUrl</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">PreviewUrl property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Progress</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Progress property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Uploading</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Uploading property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Uploaded</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Uploaded property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Error</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Error property</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ValueTask</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>async</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ValueTask property</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.FileUpload";

    private string basicCode = @"<TailFileUpload Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailFileUpload>Small</TailFileUpload>
<TailFileUpload>Medium</TailFileUpload>
<TailFileUpload>Large</TailFileUpload>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "FileUploadSize", Default = "FileUploadSize.Md", Description = "Size of the component" },
        new() { Name = "MaxFiles", Type = "int", Default = "5", Description = "Maximum value constraint" },
        new() { Name = "MaxFileSize", Type = "long", Default = "10 * 1024 * 1024", Description = "Size of the component" },
        new() { Name = "ShowPreview", Type = "bool", Default = "true", Description = "ShowPreview parameter" },
        new() { Name = "AutoUpload", Type = "bool", Default = "false", Description = "AutoUpload parameter" },
        new() { Name = "ShowUploadButton", Type = "bool", Default = "true", Description = "ShowUploadButton parameter" },
        new() { Name = "ShowRemoveButton", Type = "bool", Default = "true", Description = "ShowRemoveButton parameter" },
        new() { Name = "ShowRemoveAll", Type = "bool", Default = "true", Description = "ShowRemoveAll parameter" },
    };
}
