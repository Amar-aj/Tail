@page "/components/forms/passwordstrengthmeter"
@using Tail.Blazor.PasswordStrengthMeter
@using Tail.Blazor.Docs.Shared

<DocPageTemplate Title="PasswordStrengthMeter"
                 Description="PasswordStrengthMeter component for Tail.Blazor"
                 PackageName="Tail.Blazor.PasswordStrengthMeter"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Title="Package Installation" Code="@installCode" ShowPreview="false" Language="bash" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Example" Code="@basicCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <CodePreview Title="Size Options" Code="@sizesCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = @"dotnet add package Tail.Blazor.PasswordStrengthMeter";

    private string basicCode = @"<TailPasswordStrengthMeter Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailPasswordStrengthMeter Size=""PasswordStrengthMeterSize.Sm"">Small</TailPasswordStrengthMeter>
<TailPasswordStrengthMeter Size=""PasswordStrengthMeterSize.Md"">Medium</TailPasswordStrengthMeter>
<TailPasswordStrengthMeter Size=""PasswordStrengthMeterSize.Lg"">Large</TailPasswordStrengthMeter>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "PasswordStrengthMeterSize", Default = "PasswordStrengthMeterSize.Md", Description = "Size of the component" },
        new() { Name = "ShowStrengthMeter", Type = "bool", Default = "true", Description = "ShowStrengthMeter parameter" },
    };
}
