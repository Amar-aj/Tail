@page "/components/forms/otpinput"
@using Tail.Blazor.OTPInput
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="OTPInput"
                 Description="OTPInput component for Tail.Blazor"
                 PackageName="Tail.Blazor.OTPInput"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailOTPInput Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailOTPInput>Small</TailOTPInput>
<TailOTPInput>Medium</TailOTPInput>
<TailOTPInput>Large</TailOTPInput>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.OTPInput";

    private string basicCode = @"<TailOTPInput Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailOTPInput>Small</TailOTPInput>
<TailOTPInput>Medium</TailOTPInput>
<TailOTPInput>Large</TailOTPInput>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Length", Type = "int", Default = "6", Description = "Length parameter" },
        new() { Name = "Size", Type = "OTPInputSize", Default = "OTPInputSize.Md", Description = "Size of the component" },
    };
}
