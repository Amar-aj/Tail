@page "/components/forms/imagecropper"
@using Tail.Blazor.ImageCropper
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="ImageCropper"
                 Description="ImageCropper component for Tail.Blazor"
                 PackageName="Tail.Blazor.ImageCropper"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailImageCropper Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailImageCropper>Small</TailImageCropper>
<TailImageCropper>Medium</TailImageCropper>
<TailImageCropper>Large</TailImageCropper>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ImageCropper";

    private string basicCode = @"<TailImageCropper Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailImageCropper>Small</TailImageCropper>
<TailImageCropper>Medium</TailImageCropper>
<TailImageCropper>Large</TailImageCropper>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "ImageCropperSize", Default = "ImageCropperSize.Md", Description = "Size of the component" },
        new() { Name = "AspectRatioWidth", Type = "int", Default = "1", Description = "AspectRatioWidth parameter" },
        new() { Name = "AspectRatioHeight", Type = "int", Default = "1", Description = "AspectRatioHeight parameter" },
    };
}
