@page "/components/forms/daterangepicker"
@using Tail.Blazor.DateRangePicker
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="DateRangePicker"
                 Description="DateRangePicker component for Tail.Blazor"
                 PackageName="Tail.Blazor.DateRangePicker"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailDateRangePicker Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailDateRangePicker>Small</TailDateRangePicker>
<TailDateRangePicker>Medium</TailDateRangePicker>
<TailDateRangePicker>Large</TailDateRangePicker>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.DateRangePicker";

    private string basicCode = @"<TailDateRangePicker Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailDateRangePicker>Small</TailDateRangePicker>
<TailDateRangePicker>Medium</TailDateRangePicker>
<TailDateRangePicker>Large</TailDateRangePicker>
";

    private string statesCode = @"
<TailDateRangePicker Disabled=""true"">Disabled</TailDateRangePicker>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "ShowTime", Type = "bool", Default = "false", Description = "ShowTime parameter" },
        new() { Name = "TimeOnlyMode", Type = "bool", Default = "false", Description = "TimeOnlyMode parameter" },
        new() { Name = "HourFormat", Type = "HourFormat", Default = "HourFormat.TwentyFourHour", Description = "HourFormat parameter" },
        new() { Name = "Size", Type = "DateRangePickerSize", Default = "DateRangePickerSize.Md", Description = "Size of the component" },
        new() { Name = "DisplayMode", Type = "DatePickerDisplayMode", Default = "DatePickerDisplayMode.InputAndPopup", Description = "DisplayMode parameter" },
        new() { Name = "ShowCalendarButton", Type = "bool", Default = "true", Description = "ShowCalendarButton parameter" },
        new() { Name = "Placeholder", Type = "string?", Default = """Select date range""", Description = "Placeholder text" },
        new() { Name = "InitialViewMode", Type = "DatePickerViewMode", Default = "DatePickerViewMode.Days", Description = "InitialViewMode parameter" },
        new() { Name = "SelectionMode", Type = "DateSelectionMode", Default = "DateSelectionMode.SingleRange", Description = "SelectionMode parameter" },
        new() { Name = "Animation", Type = "CalendarAnimation", Default = "CalendarAnimation.Fade", Description = "Animation parameter" },
        new() { Name = "AnimationDuration", Type = "int", Default = "200", Description = "AnimationDuration parameter" },
        new() { Name = "DisabledDates", Type = "List<DateTime>", Default = "new()", Description = "Whether the component is disabled" },
        new() { Name = "DisabledDateOnly", Type = "List<DateOnly>", Default = "new()", Description = "Whether the component is disabled" },
        new() { Name = "SpecialDates", Type = "List<DateTime>", Default = "new()", Description = "SpecialDates parameter" },
        new() { Name = "SpecialDateOnly", Type = "List<DateOnly>", Default = "new()", Description = "SpecialDateOnly parameter" },
    };
}
