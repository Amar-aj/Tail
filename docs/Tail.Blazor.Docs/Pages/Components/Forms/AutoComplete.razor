</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.AutoComplete";

    private string basicCode = @"<TailAutoComplete>Content</TailAutoComplete>";

    private string sizesCode = @"
<TailAutoComplete Size=""AutoCompleteSize.Xs"">Xs</TailAutoComplete>
<TailAutoComplete Size=""AutoCompleteSize.Sm"">Sm</TailAutoComplete>
<TailAutoComplete Size=""AutoCompleteSize.Md"">Md</TailAutoComplete>
<TailAutoComplete Size=""AutoCompleteSize.Lg"">Lg</TailAutoComplete>
";

    private string statesCode = @"
@* Disabled state *@
<TailAutoComplete Disabled=""true"">Disabled</TailAutoComplete>

@* Loading state *@
<TailAutoComplete IsLoading=""true"">Loading...</TailAutoComplete>

@* Both disabled and loading *@
<TailAutoComplete Disabled=""true"" IsLoading=""true"">Processing</TailAutoComplete>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.AutoComplete

<TailAutoComplete>
    Hello, World!
</TailAutoComplete>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Medium Size**

```razor
<TailAutoComplete Size=""AutoCompleteSize.Md"">
    Medium Size
</TailAutoComplete>
```

**With Click Handler**

```razor
<TailAutoComplete ValueChanged=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailAutoComplete>
```

**Disabled State**

```razor
<TailAutoComplete Disabled=""true"">
    Disabled
</TailAutoComplete>
```
";

    private string eventsCode = @"
<TailAutoComplete ValueChanged=""HandleValueChanged"">
    Click Me
</TailAutoComplete>

@code {
    private void HandleValueChanged(string? args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailAutoComplete Size=""AutoCompleteSize.Sm"" Value=""Sample Value"" Items=""Sample Items"" Label=""Sample Label"" Placeholder=""Sample Placeholder"">
    Combined Parameters
</TailAutoComplete>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailAutoComplete Size=""AutoCompleteSize.Sm"" ValueChanged=""HandleAction"">
        Action Button
    </TailAutoComplete>
</div>

@code {
    private void HandleAction(string? args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "string?", Default = "-", Description = "Current value of the component" },
        new() { Name = "Items", Type = "List<string>?", Default = "-", Description = "Data items collection" },
        new() { Name = "Size", Type = "AutoCompleteSize", Default = "AutoCompleteSize.Md", Description = "Size of the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "Placeholder", Type = "string?", Default = "-", Description = "Placeholder text" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "MinChars", Type = "int", Default = "1", Description = "Minimum value constraint" },
        new() { Name = "MaxItems", Type = "int", Default = "10", Description = "Maximum value constraint" },
        new() { Name = "IsLoading", Type = "bool", Default = "-", Description = "Whether the component is in loading state" },
        new() { Name = "ItemTemplate", Type = "RenderFragment<string>?", Default = "-", Description = "ItemTemplate parameter" },
        new() { Name = "AriaLabel", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "Tooltip", Type = "string?", Default = "-", Description = "Tooltip parameter" },
    };
}
