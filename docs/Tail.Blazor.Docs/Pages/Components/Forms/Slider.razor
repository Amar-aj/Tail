@page "/components/forms/slider"
@using Tail.Blazor.Slider
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Slider"
                 Description="Slider component for Tail.Blazor"
                 PackageName="Tail.Blazor.Slider"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Range input with min/max/step</li>
            <li>3 sizes (Sm, Md, Lg)</li>
            <li>4 variants (Primary, Success, Warning, Danger)</li>
            <li>Label support</li>
            <li>Value display</li>
            <li>Min/max labels</li>
            <li>Help text</li>
            <li>Disabled state</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailSlider></TailSlider>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailSlider Variant="Tail.Blazor.Slider.SliderVariant.Primary">Primary</TailSlider>
                    <TailSlider Variant="Tail.Blazor.Slider.SliderVariant.Success">Success</TailSlider>
                    <TailSlider Variant="Tail.Blazor.Slider.SliderVariant.Warning">Warning</TailSlider>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@variantsCode" CodeElementId="variants-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailSlider Size="Tail.Blazor.Slider.SliderSize.Sm">Small</TailSlider>
                    <TailSlider Size="Tail.Blazor.Slider.SliderSize.Md">Medium</TailSlider>
                    <TailSlider Size="Tail.Blazor.Slider.SliderSize.Lg">Large</TailSlider>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Value</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Current value of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Min</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">0</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Minimum value constraint</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Max</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">100</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Maximum value constraint</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Step</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">1</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Step value for numeric inputs</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Size</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>SliderSize</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">SliderSize.Md</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Variant</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>SliderVariant</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">SliderVariant.Primary</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Visual variant style for the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Label</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Label text for the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>HelpText</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">HelpText parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowValue</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Current value of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowLabels</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Label text for the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Disabled</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Whether the component is disabled</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Style</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">-</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Additional CSS styles</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ValueChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>double</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Slider";

    private string basicCode = @"<TailSlider></TailSlider>";

    private string variantsCode = @"
<TailSlider Variant=""Tail.Blazor.Slider.SliderVariant.Primary"">Primary</TailSlider>
<TailSlider Variant=""Tail.Blazor.Slider.SliderVariant.Success"">Success</TailSlider>
<TailSlider Variant=""Tail.Blazor.Slider.SliderVariant.Warning"">Warning</TailSlider>
";

    private string sizesCode = @"
<TailSlider Size=""Tail.Blazor.Slider.SliderSize.Sm"">Small</TailSlider>
<TailSlider Size=""Tail.Blazor.Slider.SliderSize.Md"">Medium</TailSlider>
<TailSlider Size=""Tail.Blazor.Slider.SliderSize.Lg"">Large</TailSlider>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "double", Default = "-", Description = "Current value of the component" },
        new() { Name = "Min", Type = "double", Default = "0", Description = "Minimum value constraint" },
        new() { Name = "Max", Type = "double", Default = "100", Description = "Maximum value constraint" },
        new() { Name = "Step", Type = "double", Default = "1", Description = "Step value for numeric inputs" },
        new() { Name = "Size", Type = "SliderSize", Default = "SliderSize.Md", Description = "Size of the component" },
        new() { Name = "Variant", Type = "SliderVariant", Default = "SliderVariant.Primary", Description = "Visual variant style for the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "HelpText", Type = "string?", Default = "-", Description = "HelpText parameter" },
        new() { Name = "ShowValue", Type = "bool", Default = "-", Description = "Current value of the component" },
        new() { Name = "ShowLabels", Type = "bool", Default = "-", Description = "Label text for the component" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
