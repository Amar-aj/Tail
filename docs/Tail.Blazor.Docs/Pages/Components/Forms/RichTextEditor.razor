@page "/components/forms/richtexteditor"
@using Tail.Blazor.RichTextEditor
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="RichTextEditor"
                 Description="RichTextEditor component for Tail.Blazor"
                 PackageName="Tail.Blazor.RichTextEditor"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailRichTextEditor Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailRichTextEditor>Small</TailRichTextEditor>
<TailRichTextEditor>Medium</TailRichTextEditor>
<TailRichTextEditor>Large</TailRichTextEditor>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.RichTextEditor";

    private string basicCode = @"<TailRichTextEditor Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailRichTextEditor>Small</TailRichTextEditor>
<TailRichTextEditor>Medium</TailRichTextEditor>
<TailRichTextEditor>Large</TailRichTextEditor>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "RichTextEditorSize", Default = "RichTextEditorSize.Md", Description = "Size of the component" },
        new() { Name = "MinHeight", Type = "int", Default = "200", Description = "Minimum value constraint" },
    };
}
