@page "/components/forms/datepicker"
@using Tail.Blazor.DatePicker
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="DatePicker"
                 Description="DatePicker component for Tail.Blazor"
                 PackageName="Tail.Blazor.DatePicker"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailDatePicker Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailDatePicker>Small</TailDatePicker>
<TailDatePicker>Medium</TailDatePicker>
<TailDatePicker>Large</TailDatePicker>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Size</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>DatePickerSize</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">DatePickerSize.Md</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Format</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">"dd-MM-yyyy"</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Format parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>TimeFormat</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">"HH:mm"</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">TimeFormat parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>SpecialDates</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;DateTime&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">SpecialDates parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>InitialViewDate</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>DateTime</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">DateTime.Today</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">InitialViewDate parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>YearRange</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
