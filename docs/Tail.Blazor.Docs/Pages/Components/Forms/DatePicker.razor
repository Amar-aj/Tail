                            <td style="padding: 10px; border: 1px solid var(--color-border);">YearRange parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowCalendar</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowCalendar parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ShowInput</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">ShowInput parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>SelectedDates</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;DateTime&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">new()</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">SelectedDates parameter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ValueChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>DateTime?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnDateSelected</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>DateTime?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised with DateTime? value</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnDateChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>DateTime?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>SelectedDatesChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;DateTime&gt;</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>TimeOnlyValueChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>TimeOnly?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.DatePicker";

    private string basicCode = @"<TailDatePicker Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailDatePicker>Small</TailDatePicker>
<TailDatePicker>Medium</TailDatePicker>
<TailDatePicker>Large</TailDatePicker>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "DatePickerSize", Default = "DatePickerSize.Md", Description = "Size of the component" },
        new() { Name = "Format", Type = "string", Default = """dd-MM-yyyy""", Description = "Format parameter" },
        new() { Name = "TimeFormat", Type = "string", Default = """HH:mm""", Description = "TimeFormat parameter" },
        new() { Name = "SpecialDates", Type = "List<DateTime>", Default = "new()", Description = "SpecialDates parameter" },
        new() { Name = "InitialViewDate", Type = "DateTime", Default = "DateTime.Today", Description = "InitialViewDate parameter" },
        new() { Name = "YearRange", Type = "int", Default = "10", Description = "YearRange parameter" },
        new() { Name = "ShowCalendar", Type = "bool", Default = "true", Description = "ShowCalendar parameter" },
        new() { Name = "ShowInput", Type = "bool", Default = "true", Description = "ShowInput parameter" },
        new() { Name = "SelectedDates", Type = "List<DateTime>", Default = "new()", Description = "SelectedDates parameter" },
    };
}
