@page "/components/forms/datepicker"
@using Tail.Blazor.DatePicker
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="DatePicker"
                 Description="DatePicker component for Tail.Blazor"
                 PackageName="Tail.Blazor.DatePicker"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>
    <DocSection Title="Features">
        <ul style="margin-left: 20px; line-height: 1.8; color: var(--color-text-primary);">
            <li>Date input with calendar picker</li>
            <li>5 sizes (Xs, Sm, Md, Lg, Xl)</li>
            <li>Min/max date constraints</li>
            <li>Label and help text support</li>
            <li>Icon support</li>
            <li>Validation error display</li>
            <li>Required field indicator</li>
            <li>Disabled state</li>
            <li>Full theme support with CSS variables</li>
            <li>MAUI Blazor Hybrid compatible</li>
        </ul>
    </DocSection>
    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailDatePicker>Content</TailDatePicker>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Quick Start">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Get up and running in seconds.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailDatePicker>
                            Hello, World!
                        </TailDatePicker>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@quickstartCode" CodeElementId="quickstart-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Common Patterns">
