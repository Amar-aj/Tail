@page "/components/forms/datepicker"
@using Tail.Blazor.DatePicker
@using Tail.Blazor.Docs.Shared

<DocPageTemplate Title="DatePicker"
                 Description="DatePicker component for Tail.Blazor"
                 PackageName="Tail.Blazor.DatePicker"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Title="Package Installation" Code="@installCode" ShowPreview="false" Language="bash" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <CodePreview Title="Basic Example" Code="@basicCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <CodePreview Title="Size Options" Code="@sizesCode" ShowPreview="false" Language="razor" />
    </DocSection>

    <DocSection Title="Features">
        <ul class="space-y-2" style="list-style: disc; padding-left: 1.5rem;">
            <li>Full theme support with CSS variables</li>
            <li>Responsive design</li>
            <li>Accessibility features built-in</li>
            <li>Type-safe with IntelliSense</li>
        </ul>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = @"dotnet add package Tail.Blazor.DatePicker";

    private string basicCode = @"<TailDatePicker Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailDatePicker Size=""DatePickerSize.Sm"">Small</TailDatePicker>
<TailDatePicker Size=""DatePickerSize.Md"">Medium</TailDatePicker>
<TailDatePicker Size=""DatePickerSize.Lg"">Large</TailDatePicker>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "DatePickerSize", Default = "DatePickerSize.Md", Description = "Size of the component" },
        new() { Name = "Format", Type = "string", Default = """dd-MM-yyyy""", Description = "Format parameter" },
        new() { Name = "TimeFormat", Type = "string", Default = """HH:mm""", Description = "TimeFormat parameter" },
        new() { Name = "SpecialDates", Type = "List<DateTime>", Default = "new()", Description = "SpecialDates parameter" },
        new() { Name = "InitialViewDate", Type = "DateTime", Default = "DateTime.Today", Description = "InitialViewDate parameter" },
        new() { Name = "YearRange", Type = "int", Default = "10", Description = "YearRange parameter" },
        new() { Name = "ShowCalendar", Type = "bool", Default = "true", Description = "ShowCalendar parameter" },
        new() { Name = "ShowInput", Type = "bool", Default = "true", Description = "ShowInput parameter" },
        new() { Name = "SelectedDates", Type = "List<DateTime>", Default = "new()", Description = "SelectedDates parameter" },
    };
}
