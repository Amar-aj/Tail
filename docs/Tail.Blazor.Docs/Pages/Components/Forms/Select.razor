                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Items</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>List&lt;SelectItem&gt;?</code></td>
