@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Select";

    private string basicCode = @"<TailSelect>Content</TailSelect>";

    private string sizesCode = @"
<TailSelect Size=""SelectSize.Xs"">Xs</TailSelect>
<TailSelect Size=""SelectSize.Sm"">Sm</TailSelect>
<TailSelect Size=""SelectSize.Md"">Md</TailSelect>
<TailSelect Size=""SelectSize.Lg"">Lg</TailSelect>
";

    private string statesCode = @"
@* Disabled state *@
<TailSelect Disabled=""true"">Disabled</TailSelect>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.Select

<TailSelect>
    Hello, World!
</TailSelect>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Medium Size**

```razor
<TailSelect Size=""SelectSize.Md"">
    Medium Size
</TailSelect>
```

**With Click Handler**

```razor
<TailSelect ValueChanged=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailSelect>
```

**Disabled State**

```razor
<TailSelect Disabled=""true"">
    Disabled
</TailSelect>
```
";

    private string eventsCode = @"
<TailSelect ValueChanged=""HandleValueChanged"">
    Click Me
</TailSelect>

@code {
    private void HandleValueChanged(string? args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailSelect Size=""SelectSize.Sm"" Value=""Sample Value"" Label=""Sample Label"" Placeholder=""Sample Placeholder"" HelpText=""Sample HelpText"">
    Combined Parameters
</TailSelect>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailSelect Size=""SelectSize.Sm"" ValueChanged=""HandleAction"">
        Action Button
    </TailSelect>
</div>

@code {
    private void HandleAction(string? args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "string?", Default = "-", Description = "Current value of the component" },
        new() { Name = "Size", Type = "SelectSize", Default = "SelectSize.Md", Description = "Size of the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "Placeholder", Type = "string?", Default = "-", Description = "Placeholder text" },
        new() { Name = "HelpText", Type = "string?", Default = "-", Description = "HelpText parameter" },
        new() { Name = "ErrorMessage", Type = "string?", Default = "-", Description = "ErrorMessage parameter" },
        new() { Name = "Required", Type = "bool", Default = "-", Description = "Whether the component is required" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "Items", Type = "List<SelectItem>?", Default = "-", Description = "Data items collection" },
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
