@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Checkbox";

    private string basicCode = @"<TailCheckbox>Content</TailCheckbox>";

    private string sizesCode = @"
<TailCheckbox Size=""CheckboxSize.Xs"">Xs</TailCheckbox>
<TailCheckbox Size=""CheckboxSize.Sm"">Sm</TailCheckbox>
<TailCheckbox Size=""CheckboxSize.Md"">Md</TailCheckbox>
<TailCheckbox Size=""CheckboxSize.Lg"">Lg</TailCheckbox>
";

    private string statesCode = @"
@* Disabled state *@
<TailCheckbox Disabled=""true"">Disabled</TailCheckbox>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.Checkbox

<TailCheckbox>
    Hello, World!
</TailCheckbox>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Medium Size**

```razor
<TailCheckbox Size=""CheckboxSize.Md"">
    Medium Size
</TailCheckbox>
```

**With Click Handler**

```razor
<TailCheckbox IsCheckedChanged=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailCheckbox>
```

**Disabled State**

```razor
<TailCheckbox Disabled=""true"">
    Disabled
</TailCheckbox>
```
";

    private string eventsCode = @"
<TailCheckbox IsCheckedChanged=""HandleIsCheckedChanged"">
    Click Me
</TailCheckbox>

@code {
    private void HandleIsCheckedChanged(bool args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailCheckbox Size=""CheckboxSize.Sm"" IsChecked=""true"" Label=""Sample Label"" ErrorMessage=""Sample ErrorMessage"">
    Combined Parameters
</TailCheckbox>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailCheckbox Size=""CheckboxSize.Sm"" IsCheckedChanged=""HandleAction"">
        Action Button
    </TailCheckbox>
</div>

@code {
    private void HandleAction(bool args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "IsChecked", Type = "bool", Default = "-", Description = "IsChecked parameter" },
        new() { Name = "Size", Type = "CheckboxSize", Default = "CheckboxSize.Md", Description = "Size of the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
        new() { Name = "ErrorMessage", Type = "string?", Default = "-", Description = "ErrorMessage parameter" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "IsIndeterminate", Type = "bool", Default = "-", Description = "Minimum value constraint" },
        new() { Name = "CustomCheckIcon", Type = "RenderFragment?", Default = "-", Description = "Icon to display" },
        new() { Name = "AriaLabel", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "Tooltip", Type = "string?", Default = "-", Description = "Tooltip parameter" },
    };
}
