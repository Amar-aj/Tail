                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Radio";

    private string basicCode = @"<TailRadio>Content</TailRadio>";

    private string sizesCode = @"
<TailRadio Size=""RadioSize.Xs"">Xs</TailRadio>
<TailRadio Size=""RadioSize.Sm"">Sm</TailRadio>
<TailRadio Size=""RadioSize.Md"">Md</TailRadio>
<TailRadio Size=""RadioSize.Lg"">Lg</TailRadio>
";

    private string statesCode = @"
@* Disabled state *@
<TailRadio Disabled=""true"">Disabled</TailRadio>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.Radio

<TailRadio>
    Hello, World!
</TailRadio>
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Medium Size**

```razor
<TailRadio Size=""RadioSize.Md"">
    Medium Size
</TailRadio>
```

**With Click Handler**

```razor
<TailRadio IsCheckedChanged=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailRadio>
```

**Disabled State**

```razor
<TailRadio Disabled=""true"">
    Disabled
</TailRadio>
```
";

    private string eventsCode = @"
<TailRadio IsCheckedChanged=""HandleIsCheckedChanged"">
    Click Me
</TailRadio>

@code {
    private void HandleIsCheckedChanged(bool args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailRadio Size=""RadioSize.Sm"" Value=""Sample Value"" GroupName=""Sample GroupName"" IsChecked=""true"" Label=""Sample Label"">
    Combined Parameters
</TailRadio>
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailRadio Size=""RadioSize.Sm"" IsCheckedChanged=""HandleAction"">
        Action Button
    </TailRadio>
</div>

@code {
    private void HandleAction(bool args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "string?", Default = "-", Description = "Current value of the component" },
        new() { Name = "GroupName", Type = "string?", Default = "-", Description = "GroupName parameter" },
        new() { Name = "IsChecked", Type = "bool", Default = "-", Description = "IsChecked parameter" },
        new() { Name = "Size", Type = "RadioSize", Default = "RadioSize.Md", Description = "Size of the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "ChildContent", Type = "RenderFragment?", Default = "-", Description = "ChildContent parameter" },
        new() { Name = "ErrorMessage", Type = "string?", Default = "-", Description = "ErrorMessage parameter" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
