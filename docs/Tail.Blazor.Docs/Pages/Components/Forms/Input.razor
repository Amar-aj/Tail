@page "/components/forms/input"
@using Tail.Blazor.Input
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Input"
                 Description="Input component for Tail.Blazor"
                 PackageName="Tail.Blazor.Input"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailInput Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Variants">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Different visual variants for various use cases.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailInput>Default</TailInput>
<TailInput>Variant 1</TailInput>
<TailInput>Variant 2</TailInput>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@variantsCode" CodeElementId="variants-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailInput>Small</TailInput>
<TailInput>Medium</TailInput>
<TailInput>Large</TailInput>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="API Reference">
        <!-- Parameters/Properties Table -->
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Properties</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Name</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Default</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Type</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>InputType</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">InputType.Text</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Type parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Size</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>InputSize</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">InputSize.Md</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Size of the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>Variant</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>InputVariant</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">InputVariant.Standard</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Visual variant style for the component</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>AutoFocus</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">false</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AutoFocus parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>EnableAnimation</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>bool</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">true</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">EnableAnimation parameter</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>AnimationDuration</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>int</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">200</td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">AnimationDuration parameter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-6">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text-primary);">Events</h3>
            <div class="overflow-x-auto">
                <table style="width: 100%; border-collapse: collapse; color: var(--color-text-primary);">
                    <thead style="background-color: var(--color-surface-2);">
                        <tr>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Event</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Type</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid var(--color-border);">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>ValueChanged</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>string?</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when value changes</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnFocus</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FocusEventArgs</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when focus is gained</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnBlur</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>FocusEventArgs</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised when focus is lost</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>OnKeyDown</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);"><code>KeyboardEventArgs</code></td>
                            <td style="padding: 10px; border: 1px solid var(--color-border);">Raised on key down</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Input";

    private string basicCode = @"<TailInput Placeholder=""Enter text..."" />";

    private string variantsCode = @"
<TailInput>Default</TailInput>
<TailInput>Variant 1</TailInput>
<TailInput>Variant 2</TailInput>
";

    private string sizesCode = @"
<TailInput>Small</TailInput>
<TailInput>Medium</TailInput>
<TailInput>Large</TailInput>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Type", Type = "InputType", Default = "InputType.Text", Description = "Type parameter" },
        new() { Name = "Size", Type = "InputSize", Default = "InputSize.Md", Description = "Size of the component" },
        new() { Name = "Variant", Type = "InputVariant", Default = "InputVariant.Standard", Description = "Visual variant style for the component" },
        new() { Name = "AutoFocus", Type = "bool", Default = "false", Description = "AutoFocus parameter" },
        new() { Name = "EnableAnimation", Type = "bool", Default = "true", Description = "EnableAnimation parameter" },
        new() { Name = "AnimationDuration", Type = "int", Default = "200", Description = "AnimationDuration parameter" },
    };
}
