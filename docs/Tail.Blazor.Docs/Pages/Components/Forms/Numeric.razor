@page "/components/forms/numeric"
@using Tail.Blazor.Numeric
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="Numeric"
                 Description="Numeric component for Tail.Blazor"
                 PackageName="Tail.Blazor.Numeric"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailNumeric Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailNumeric>Small</TailNumeric>
<TailNumeric>Medium</TailNumeric>
<TailNumeric>Large</TailNumeric>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.Numeric";

    private string basicCode = @"<TailNumeric Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailNumeric>Small</TailNumeric>
<TailNumeric>Medium</TailNumeric>
<TailNumeric>Large</TailNumeric>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Min", Type = "decimal", Default = "decimal.MinValue", Description = "Minimum value constraint" },
        new() { Name = "Max", Type = "decimal", Default = "decimal.MaxValue", Description = "Maximum value constraint" },
        new() { Name = "Step", Type = "decimal", Default = "1", Description = "Step value for numeric inputs" },
        new() { Name = "Size", Type = "NumericSize", Default = "NumericSize.Md", Description = "Size of the component" },
    };
}
