@page "/components/forms/phonenumberinput"
@using Tail.Blazor.PhoneNumberInput
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="PhoneNumberInput"
                 Description="PhoneNumberInput component for Tail.Blazor"
                 PackageName="Tail.Blazor.PhoneNumberInput"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailPhoneNumberInput Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailPhoneNumberInput>Small</TailPhoneNumberInput>
<TailPhoneNumberInput>Medium</TailPhoneNumberInput>
<TailPhoneNumberInput>Large</TailPhoneNumberInput>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.PhoneNumberInput";

    private string basicCode = @"<TailPhoneNumberInput Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailPhoneNumberInput>Small</TailPhoneNumberInput>
<TailPhoneNumberInput>Medium</TailPhoneNumberInput>
<TailPhoneNumberInput>Large</TailPhoneNumberInput>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "SelectedCountryCode", Type = "string", Default = """+1""", Description = "SelectedCountryCode parameter" },
        new() { Name = "Size", Type = "PhoneNumberInputSize", Default = "PhoneNumberInputSize.Md", Description = "Size of the component" },
    };
}
