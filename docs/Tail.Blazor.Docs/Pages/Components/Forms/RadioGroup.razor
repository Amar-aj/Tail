        new() { Name = "HelpText", Type = "string?", Default = "-", Description = "HelpText parameter" },
        new() { Name = "ErrorMessage", Type = "string?", Default = "-", Description = "ErrorMessage parameter" },
        new() { Name = "Required", Type = "bool", Default = "-", Description = "Whether the component is required" },
        new() { Name = "Orientation", Type = "RadioGroupOrientation", Default = "RadioGroupOrientation.Vertical", Description = "Orientation parameter" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
