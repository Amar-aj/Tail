@page "/components/forms/colorpicker"
@using Tail.Blazor.ColorPicker
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="ColorPicker"
                 Description="ColorPicker component for Tail.Blazor"
                 PackageName="Tail.Blazor.ColorPicker"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailColorPicker Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailColorPicker>Small</TailColorPicker>
<TailColorPicker>Medium</TailColorPicker>
<TailColorPicker>Large</TailColorPicker>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ColorPicker";

    private string basicCode = @"<TailColorPicker Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailColorPicker>Small</TailColorPicker>
<TailColorPicker>Medium</TailColorPicker>
<TailColorPicker>Large</TailColorPicker>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Size", Type = "ColorPickerSize", Default = "ColorPickerSize.Md", Description = "Size of the component" },
        new() { Name = "ShowPreview", Type = "bool", Default = "true", Description = "ShowPreview parameter" },
    };
}
