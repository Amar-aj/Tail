            <Content>
                <TailTabPanel>
                    <PreviewUI>
                    <TailColorPicker Size="Tail.Blazor.ColorPicker.ColorPickerSize.Xs">Xs</TailColorPicker>
                    <TailColorPicker Size="Tail.Blazor.ColorPicker.ColorPickerSize.Sm">Sm</TailColorPicker>
                    <TailColorPicker Size="Tail.Blazor.ColorPicker.ColorPickerSize.Md">Md</TailColorPicker>
                    <TailColorPicker Size="Tail.Blazor.ColorPicker.ColorPickerSize.Lg">Lg</TailColorPicker>
