@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.ColorPicker";

    private string basicCode = @"<TailColorPicker />";

    private string sizesCode = @"
<TailColorPicker Size=""ColorPickerSize.Xs"">Xs</TailColorPicker>
<TailColorPicker Size=""ColorPickerSize.Sm"">Sm</TailColorPicker>
<TailColorPicker Size=""ColorPickerSize.Md"">Md</TailColorPicker>
<TailColorPicker Size=""ColorPickerSize.Lg"">Lg</TailColorPicker>
";

    private string statesCode = @"
@* Disabled state *@
<TailColorPicker Disabled=""true"">Disabled</TailColorPicker>
";

    private string quickstartCode = @"
@page ""/quickstart""
@using Tail.Blazor.ColorPicker

<TailColorPicker />
";

    private string patternsCode = @"
Frequently used patterns and combinations:

**Medium Size**

```razor
<TailColorPicker Size=""ColorPickerSize.Md"">
    Medium Size
</TailColorPicker>
```

**With Click Handler**

```razor
<TailColorPicker ValueChanged=""() => Console.WriteLine(""Clicked"")"">
    Click Me
</TailColorPicker>
```

**Disabled State**

```razor
<TailColorPicker Disabled=""true"">
    Disabled
</TailColorPicker>
```
";

    private string eventsCode = @"
<TailColorPicker ValueChanged=""HandleValueChanged"">
    Click Me
</TailColorPicker>

@code {
    private void HandleValueChanged(string? args)
    {
        // Handle the event
        Console.WriteLine($""Event triggered: {args}"");
    }
}
";

    private string combinationsCode = @"
<TailColorPicker Size=""ColorPickerSize.Sm"" Value=""Sample Value"" Label=""Sample Label"" HelpText=""Sample HelpText"" ShowPreview=""true"" />
";

    private string advancedCode = @"
More complex usage scenarios:

##
";

    private string realworldCode = @"
@page ""/example""

<h3>Component Demo</h3>

<div class=""space-y-4"">
    <TailColorPicker Size=""ColorPickerSize.Sm"" ValueChanged=""HandleAction"" />
</div>

@code {
    private void HandleAction(string? args)
    {
        // Perform action
        Console.WriteLine(""Action executed"");
    }
}
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Value", Type = "string?", Default = "-", Description = "Current value of the component" },
        new() { Name = "Size", Type = "ColorPickerSize", Default = "ColorPickerSize.Md", Description = "Size of the component" },
        new() { Name = "Label", Type = "string?", Default = "-", Description = "Label text for the component" },
        new() { Name = "HelpText", Type = "string?", Default = "-", Description = "HelpText parameter" },
        new() { Name = "ShowPreview", Type = "bool", Default = "true", Description = "ShowPreview parameter" },
        new() { Name = "Disabled", Type = "bool", Default = "-", Description = "Whether the component is disabled" },
        new() { Name = "Style", Type = "string?", Default = "-", Description = "Additional CSS styles" },
    };
}
