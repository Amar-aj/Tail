@page "/components/forms/taginput"
@using Tail.Blazor.TagInput
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="TagInput"
                 Description="TagInput component for Tail.Blazor"
                 PackageName="Tail.Blazor.TagInput"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailTagInput Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailTagInput>Small</TailTagInput>
<TailTagInput>Medium</TailTagInput>
<TailTagInput>Large</TailTagInput>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.TagInput";

    private string basicCode = @"<TailTagInput Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailTagInput>Small</TailTagInput>
<TailTagInput>Medium</TailTagInput>
<TailTagInput>Large</TailTagInput>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "Tags", Type = "List<string>", Default = "new()", Description = "Tags parameter" },
        new() { Name = "Size", Type = "TagInputSize", Default = "TagInputSize.Md", Description = "Size of the component" },
    };
}
