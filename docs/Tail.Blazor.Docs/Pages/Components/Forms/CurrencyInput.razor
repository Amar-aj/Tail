@page "/components/forms/currencyinput"
@using Tail.Blazor.CurrencyInput
@using Tail.Blazor.Docs.Shared
@using Tail.Blazor.Tabs

<DocPageTemplate Title="CurrencyInput"
                 Description="CurrencyInput component for Tail.Blazor"
                 PackageName="Tail.Blazor.CurrencyInput"
                 ApiParameters="@apiParameters">
    
    <DocSection Title="Installation">
        <CodePreview Code="@installCode" CodeElementId="install-code" />
    </DocSection>

    <DocSection Title="Basic Usage">
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailCurrencyInput Placeholder="Enter text..." />
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@basicCode" CodeElementId="basic-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>

    <DocSection Title="Sizes">
        <p class="mb-4" style="color: var(--color-text-secondary);">
            Size options to fit different layouts and contexts.
        </p>
        <TailTabs ActiveIndex="0">
            <Items>
                <TailTabItem Label="Preview" />
                <TailTabItem Label="Code" />
            </Items>
            <Content>
                <TailTabPanel>
                    <PreviewUI>
                        <TailCurrencyInput>Small</TailCurrencyInput>
<TailCurrencyInput>Medium</TailCurrencyInput>
<TailCurrencyInput>Large</TailCurrencyInput>
                    </PreviewUI>
                </TailTabPanel>
                <TailTabPanel>
                    <CodePreview Code="@sizesCode" CodeElementId="sizes-code" />
                </TailTabPanel>
            </Content>
        </TailTabs>
    </DocSection>
</DocPageTemplate>

@code {
    private bool isGeneric = false;
    private bool isMissing = false;

    private string installCode = "dotnet add package Tail.Blazor.CurrencyInput";

    private string basicCode = @"<TailCurrencyInput Placeholder=""Enter text..."" />";

    private string sizesCode = @"
<TailCurrencyInput>Small</TailCurrencyInput>
<TailCurrencyInput>Medium</TailCurrencyInput>
<TailCurrencyInput>Large</TailCurrencyInput>
";

    private string statesCode = @"
<TailComponent Disabled=""true"">Disabled</TailComponent>
";

    private List<DocPageTemplate.ApiParameter> apiParameters = new()
    {
        new() { Name = "CurrencySymbol", Type = "string", Default = """$""", Description = "CurrencySymbol parameter" },
        new() { Name = "SymbolPosition", Type = "CurrencySymbolPosition", Default = "CurrencySymbolPosition.Left", Description = "SymbolPosition parameter" },
        new() { Name = "Size", Type = "CurrencyInputSize", Default = "CurrencyInputSize.Md", Description = "Size of the component" },
    };
}
